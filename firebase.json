{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "/{sw.js,firebase-messaging-sw-*.js}",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "rewrites": [
      {
        "source": "/mcp/helm",
        "function": { "functionId": "helmMcp", "region": "us-central1" }
      },
      {
        "source": "/.well-known/oauth-protected-resource/mcp/helm",
        "function": { "functionId": "helmMcp", "region": "us-central1" }
      },
      {
        "source": "/.well-known/oauth-protected-resource",
        "function": { "functionId": "helmMcp", "region": "us-central1" }
      },
      {
        "source": "/.well-known/oauth-authorization-server",
        "function": { "functionId": "helmMcp", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "database": "(default)",
    "location": "nam5",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "database": {
      "port": 9000
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4001
    }
  }
}
