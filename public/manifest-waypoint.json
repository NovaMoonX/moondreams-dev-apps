{
  "name": "Waypoint - Moondreams Dev Apps",
  "short_name": "Waypoint",
  "description": "A collaborative trip planner for shared itineraries, checklists, and live travel coordination.",
  "id": "/waypoint/",
  "start_url": "/waypoint/",
  "scope": "/waypoint/",
  "scope_extensions": [
    {
      "type": "origin",
      "origin": "https://apps.moondreams.dev"
    }
  ],
  "display": "standalone",
  "background_color": "#f5f3ff",
  "theme_color": "#7c3aed",
  "user_preferences": {
    "color_scheme_dark": {
      "background_color": "#0f172a",
      "theme_color": "#000000"
    }
  },
  "icons": [
    {
      "src": "/logos/by-app/logo-waypoint.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/logos/by-app/logo-waypoint.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ]
}
