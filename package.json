{
  "name": "moondreams-dev-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "emulators": "firebase emulators:start --only auth,firestore,database,functions,storage",
    "emulators:kill": "pkill -f '[f]irebase emulators:start' ; pkill -f '[f]irebase-database-emulator' ; pkill -f '[c]loud-firestore-emulator' ; pkill -f '[f]irebase-auth-emulator' ; pkill -f '[p]ubsub-emulator' ; pkill -f '[c]loud-storage-rules-runtime' ; true",
    "seed": "FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000 GCLOUD_PROJECT=moondreams-dev-apps TSX_TSCONFIG_PATH=./tsconfig.app.json tsx scripts/seed.ts",
    "seed:core": "npm run seed -- --scope core",
    "seed:nine-lives": "npm run seed -- --scope nine-lives",
    "seed:waypoint": "npm run seed -- --scope waypoint",
    "seed:worth-the-wait": "npm run seed -- --scope worth-the-wait",
    "seed:reset": "npm run seed -- --scope all --reset",
    "emulators:seed": "firebase emulators:exec --project moondreams-dev-apps --only auth,firestore,database,functions,storage \"npm run seed\"",
    "emulators:seed:reset": "firebase emulators:exec --project moondreams-dev-apps --only auth,firestore,database,functions,storage \"npm run seed:reset\"",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build && npm run preview",
    "cf:worker": "npx wrangler deploy",
    "fb:deploy": "npm run build && firebase deploy",
    "fb:rules:database": "firebase deploy --only database",
    "fb:rules:firestore": "firebase deploy --only firestore:rules",
    "fb:rules:storage": "firebase deploy --only storage",
    "fb:rules": "firebase deploy --only database,firestore:rules,storage",
    "fb:indexes": "firebase deploy --only firestore:indexes",
    "fb:functions": "cd functions && npm run build && firebase deploy --only functions",
    "fb:deploy:smart": "tsx scripts/fbDeploySmart.ts",
    "fb:all": "npm run fb:deploy:smart",
    "issues:create": "bash scripts/createGithubIssues.sh",
    "issues:create:dry-run": "bash scripts/createGithubIssues.sh"
  },
  "dependencies": {
    "@moondreamsdev/dreamer-ui": "^1.7.26",
    "@reduxjs/toolkit": "^2.12.0",
    "firebase": "12.16.0",
    "firebase-admin": "^13.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase-tools": "^15.27.0",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-qrcode": "^0.4.1"
  }
}
