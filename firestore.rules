        && isExpenseIdentityValid()
        && isExpenseBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isExpenseImmutableFieldsValid()
        && isExpenseBaseShapeValid();
