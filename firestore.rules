rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        request.auth.token.email == 'nova@moondreams.dev'
      );
    }

    function isHouseholdMember(householdId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId))
        && request.auth.uid in get(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)).data.members;
    }

    function isTimestampNumber(value) {
      return value is number;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // `dev` is only ever set by scripts/seeds/core.ts, which refuses to run
    // against anything but a local emulator — so it never appears on a
    // production token. Lets seeded users see every app locally.
    function isDevUser() {
      return request.auth != null && 'dev' in request.auth.token && request.auth.token.dev == true;
    }

    // Each predicate is its own `allow read`, not OR'd together — Firestore's
    // list() safety check can't prove a combined expression once a query mixes
    // equality filters with array-contains, and denies reads get() allows fine.
    // Only `status` is existence-guarded; short-circuit order protects the rest.
    function isUnrestrictedPublicApp(appData) {
      return ('status' in appData) && appData.status == 'public' && appData.isRestricted != true;
    }

    function isUidAllowedApp(appData) {
      return ('status' in appData) && appData.status == 'public' && appData.isRestricted == true
        && request.auth != null
        && request.auth.uid in appData.allowedUsers;
    }

    function isEmailAllowedApp(appData) {
      return ('status' in appData) && appData.status == 'public' && appData.isRestricted == true
        && request.auth != null && ('email' in request.auth.token)
        && request.auth.token.email in appData.allowedUsers;
    }

    // Apps below use explicit paths (not a generic wildcard) so each app's
    // rules stay isolated, kept in alphabetical order by app id. A generic
    // /apps/{appId} fallback for apps without a block yet is at the bottom.

    // --- App: nine-lives ---

    match /apps/nine-lives {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/nine-lives/inviteCodes/{inviteCode} {
      function isInviteCodeShapeValid() {
        return request.resource.data.keys().hasOnly(['householdId'])
          && request.resource.data.householdId is string
          && request.resource.data.householdId.size() > 0;
      }

      function getInviteHouseholdAfter() {
        return getAfter(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId));
      }

      function isInviteCodeCreateValid() {
        return request.auth != null
          && inviteCode.size() == 6
          && isInviteCodeShapeValid()
          && !exists(/databases/$(database)/documents/apps/nine-lives/inviteCodes/$(inviteCode))
          && existsAfter(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId))
          && getInviteHouseholdAfter().data.createdBy == request.auth.uid
          && request.auth.uid in getInviteHouseholdAfter().data.members
          && getInviteHouseholdAfter().data.inviteCode == inviteCode;
      }

      // get() only — a household is joined by knowing its exact code, not
      // by enumerating every code, so listing this collection is denied.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isInviteCodeCreateValid();
      allow update: if false;
      allow delete: if false;
    }

    match /apps/nine-lives/households/{householdId} {
      function isHouseholdIdentityValid() {
        return request.resource.data.id == householdId
          && request.resource.data.createdBy == request.auth.uid;
      }

      function isHouseholdBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      // A member being added must correspond to a real pending request that
      // existed before this write and is deleted in the same commit — the
      // client batch is not itself a security boundary.
      function isApprovedMemberAddition() {
        let addedUids = request.resource.data.members.removeAll(resource.data.members);
        return addedUids.size() == 1
          && exists(/databases/$(database)/documents/apps/nine-lives/pendingRequests/$(addedUids[0] + '_' + householdId))
          && !existsAfter(/databases/$(database)/documents/apps/nine-lives/pendingRequests/$(addedUids[0] + '_' + householdId));
      }

      function isHouseholdUpdateValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members.hasAll(resource.data.members)
          && (
            request.resource.data.members == resource.data.members
              || isApprovedMemberAddition()
          )
          && (request.resource.data.inviteCode == resource.data.inviteCode || resource.data.inviteCode == null)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isHouseholdCreateValid() {
        return request.auth != null
          && isHouseholdIdentityValid()
          && isHouseholdBaseShapeValid();
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if isHouseholdCreateValid();
      allow update: if isHouseholdMember(householdId) && isHouseholdUpdateValid();
      allow delete: if false;
    }

    match /apps/nine-lives/pendingRequests/{requestId} {
      function requestUid() {
        return requestId.split('_')[0];
      }

      function isPendingRequestIdentityValid() {
        return request.resource.data.uid is string && request.resource.data.uid.size() > 0
          && request.resource.data.householdId is string && request.resource.data.householdId.size() > 0
          && requestId == request.resource.data.uid + '_' + request.resource.data.householdId
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.requestedAt is number;
      }

      function isPendingRequestCreateValid() {
        return request.auth != null
          && request.auth.uid == request.resource.data.uid
          && exists(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId))
          && !isHouseholdMember(request.resource.data.householdId)
          // The submitted code must be the household's real invite code —
          // knowing a householdId alone must never be enough to request in.
          && get(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId)).data.inviteCode == request.resource.data.inviteCode
          && isPendingRequestIdentityValid();
      }

      // Path form covers get() on a not-yet-existing request; data-field
      // form lets the "my requests" list query prove list-safety.
      allow read: if request.auth != null && (
        request.auth.uid == requestUid()
          || (resource != null && resource.data.uid == request.auth.uid)
          || (resource != null && isHouseholdMember(resource.data.householdId))
      );
      allow create: if isPendingRequestCreateValid();
      allow delete: if request.auth != null && (
        request.auth.uid == requestUid()
          || (resource != null && isHouseholdMember(resource.data.householdId))
      );
      allow update: if false;
    }

    match /apps/nine-lives/conditionLibrary/{conditionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /apps/nine-lives/households/{householdId}/cats/{catId} {
      function isCatIdentityValid() {
        return request.resource.data.id == catId
          && request.resource.data.householdId == householdId;
      }

      function isCatBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && isTimestampNumber(request.resource.data.dateOfBirth)
          && request.resource.data.isDateOfBirthEstimated is bool
          && isNonEmptyString(request.resource.data.breed)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isCatCreateOwnershipValid() {
        return request.resource.data.createdBy == request.auth.uid
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isCatImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isCatCreateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isCatIdentityValid()
          && isCatBaseShapeValid()
          && isCatCreateOwnershipValid();
      }

      function isCatUpdateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isCatImmutableFieldsValid()
          && isCatBaseShapeValid();
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if isCatCreateValid();
      allow update: if isCatUpdateValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId) && resource.data.createdBy == request.auth.uid;
    }

    match /apps/nine-lives/households/{householdId}/conditions/{conditionId} {
      function isConditionIdentityValid() {
        return request.resource.data.id == conditionId
          && request.resource.data.catId is string;
      }

      function isConditionBaseShapeValid() {
        return (
          request.resource.data.source == 'library' || request.resource.data.source == 'custom'
        )
          && isNonEmptyString(request.resource.data.name)
          && (
            request.resource.data.category == 'illness'
              || request.resource.data.category == 'injury'
              || request.resource.data.category == 'chronic'
              || request.resource.data.category == 'parasite'
              || request.resource.data.category == 'allergy'
          )
          && isTimestampNumber(request.resource.data.occurredAt)
          && (request.resource.data.resolvedAt == null || isTimestampNumber(request.resource.data.resolvedAt))
          && (request.resource.data.description == null || request.resource.data.description is string)
          && request.resource.data.linkedVisitIds is list
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (
            (request.resource.data.source == 'library' && request.resource.data.libraryConditionId is string && request.resource.data.libraryConditionId.size() > 0)
              || (request.resource.data.source == 'custom' && request.resource.data.libraryConditionId == null)
          );
      }

      function isConditionImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isConditionIdentityValid()
        && isConditionBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isConditionImmutableFieldsValid()
        && isConditionBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/vaccinations/{vaccinationId} {
      function isVaccinationIdentityValid() {
        return request.resource.data.id == vaccinationId
          && request.resource.data.householdId == householdId
          && request.resource.data.catId is string;
      }

      function isVaccinationBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && request.resource.data.history is list
          && request.resource.data.history.size() > 0
          && isTimestampNumber(request.resource.data.firstAdministeredAt)
          && isTimestampNumber(request.resource.data.lastAdministeredAt)
          && (request.resource.data.expiresAt == null || isTimestampNumber(request.resource.data.expiresAt))
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isVaccinationImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.firstAdministeredAt == resource.data.firstAdministeredAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isVaccinationIdentityValid()
        && isVaccinationBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isVaccinationImmutableFieldsValid()
        && isVaccinationBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/preventives/{preventiveId} {
      function isPreventiveIdentityValid() {
        return request.resource.data.id == preventiveId
          && request.resource.data.householdId == householdId
          && request.resource.data.catIds is list
          && request.resource.data.catIds.size() > 0;
      }

      function isPreventiveBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && (request.resource.data.customProductId == null || request.resource.data.customProductId is string)
          && request.resource.data.type in ['flea-tick', 'heartworm', 'mite', 'dewormer', 'medication', 'other', 'custom']
          && (request.resource.data.customTypeId == null || request.resource.data.customTypeId is string)
          && request.resource.data.history is list
          && request.resource.data.history.size() > 0
          && isTimestampNumber(request.resource.data.firstAdministeredAt)
          && isTimestampNumber(request.resource.data.lastAdministeredAt)
          && (request.resource.data.expiresAt == null || isTimestampNumber(request.resource.data.expiresAt))
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (
            request.resource.data.customProductId == null
              || exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/customPreventiveProducts/$(request.resource.data.customProductId))
          )
          && (
            request.resource.data.customTypeId == null
              || exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/customPreventiveTypes/$(request.resource.data.customTypeId))
          )
          && (request.resource.data.type != 'custom' || request.resource.data.customTypeId is string);
      }

      function isPreventiveImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.firstAdministeredAt == resource.data.firstAdministeredAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isPreventiveIdentityValid()
        && isPreventiveBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isPreventiveImmutableFieldsValid()
        && isPreventiveBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/weightEntries/{weightEntryId} {
      function isWeightEntryIdentityValid() {
        return request.resource.data.id == weightEntryId
          && request.resource.data.catId is string;
      }

      function isWeightEntryBaseShapeValid() {
        return request.resource.data.weight is number
          && request.resource.data.weight > 0
          && (request.resource.data.unit == 'lb' || request.resource.data.unit == 'kg')
          && isTimestampNumber(request.resource.data.measuredAt)
          && (request.resource.data.linkedVisitId == null || request.resource.data.linkedVisitId is string)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isWeightEntryImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isWeightEntryIdentityValid()
        && isWeightEntryBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isWeightEntryImmutableFieldsValid()
        && isWeightEntryBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/symptoms/{symptomId} {
      function isSymptomIdentityValid() {
        return request.resource.data.id == symptomId
          && request.resource.data.catId is string;
      }

      function isSymptomBaseShapeValid() {
        return request.resource.data.description is string
          && request.resource.data.quickTags is list
          && request.resource.data.firstNoticedAt is number
          && (request.resource.data.severity == null || request.resource.data.severity in ['mild', 'moderate', 'severe'])
          && request.resource.data.linkedVisitIds is list
          && (request.resource.data.linkedConditionId == null || request.resource.data.linkedConditionId is string)
          && (request.resource.data.resolvedAt == null || isTimestampNumber(request.resource.data.resolvedAt))
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isSymptomImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isSymptomIdentityValid()
        && isSymptomBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isSymptomImmutableFieldsValid()
        && isSymptomBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/vetClinics/{clinicId} {
      function isVetClinicIdentityValid() {
        return request.resource.data.id == clinicId
          && request.resource.data.householdId == householdId;
      }

      function isVetClinicBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && (request.resource.data.phone == null || request.resource.data.phone is string)
          && (request.resource.data.address == null || request.resource.data.address is string)
          && (request.resource.data.isEmergency24Hour == null || request.resource.data.isEmergency24Hour is bool)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isVetClinicImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isVetClinicCreateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isVetClinicIdentityValid()
          && isVetClinicBaseShapeValid();
      }

      function isVetClinicUpdateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isVetClinicImmutableFieldsValid()
          && isVetClinicBaseShapeValid();
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if isVetClinicCreateValid();
      allow update: if isVetClinicUpdateValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/doctors/{doctorId} {
      function isDoctorIdentityValid() {
        return request.resource.data.id == doctorId
          && request.resource.data.householdId == householdId
          && request.resource.data.clinicId is string
          && request.resource.data.clinicId.size() > 0;
      }

      function isDoctorBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isDoctorImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.clinicId == resource.data.clinicId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isDoctorCreateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isDoctorIdentityValid()
          && isDoctorBaseShapeValid();
      }

      function isDoctorUpdateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isDoctorImmutableFieldsValid()
          && isDoctorBaseShapeValid();
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if isDoctorCreateValid();
      allow update: if isDoctorUpdateValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/customHealthRecordTypes/{typeId} {
      function isCustomHealthRecordTypeIdentityValid() {
        return request.resource.data.id == typeId
          && request.resource.data.householdId == householdId;
      }

      function isCustomHealthRecordTypeShapeValid() {
        return isNonEmptyString(request.resource.data.label)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isCustomHealthRecordTypeImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomHealthRecordTypeIdentityValid()
        && isCustomHealthRecordTypeShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomHealthRecordTypeImmutableFieldsValid()
        && isCustomHealthRecordTypeShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/customPreventiveProducts/{productId} {
      function isCustomPreventiveProductIdentityValid() {
        return request.resource.data.id == productId
          && request.resource.data.householdId == householdId;
      }

      function isCustomPreventiveProductShapeValid() {
        return isNonEmptyString(request.resource.data.label)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isCustomPreventiveProductImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomPreventiveProductIdentityValid()
        && isCustomPreventiveProductShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomPreventiveProductImmutableFieldsValid()
        && isCustomPreventiveProductShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/customPreventiveTypes/{typeId} {
      function isCustomPreventiveTypeIdentityValid() {
        return request.resource.data.id == typeId
          && request.resource.data.householdId == householdId;
      }

      function isCustomPreventiveTypeShapeValid() {
        return isNonEmptyString(request.resource.data.label)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
