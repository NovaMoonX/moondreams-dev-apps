rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'nova@moondreams.dev'
      );
    }

    match /apps/worth-the-wait {
      allow read: if !resource.data.isRestricted || (
        request.auth != null && (
          request.auth.uid in resource.data.allowedUsers ||
          request.auth.token.email in resource.data.allowedUsers ||
          isAdmin()
        )
      );
      allow create, update, delete: if isAdmin();
    }

    match /apps/worth-the-wait/inviteCodes/{inviteCode} {
      function isInviteCodeShapeValid() {
        return request.resource.data.keys().hasOnly(['spaceId'])
          && request.resource.data.spaceId is string
          && request.resource.data.spaceId.size() > 0;
      }

      function getInviteSpaceAfter() {
        return getAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId));
      }

      function isInviteCodeCreateValid() {
        return request.auth != null
          && inviteCode.size() == 6
          && isInviteCodeShapeValid()
          && !exists(/databases/$(database)/documents/apps/worth-the-wait/inviteCodes/$(inviteCode))
          && existsAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId))
          && getInviteSpaceAfter().data.createdBy == request.auth.uid
          && request.auth.uid in getInviteSpaceAfter().data.members
          && getInviteSpaceAfter().data.inviteCode == inviteCode;
      }

      function isInviteCodeDeleteValid() {
        return request.auth != null
          && resource.data.spaceId is string
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId))
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId)).data.createdBy == request.auth.uid;
      }

      allow read: if request.auth != null;
      allow create: if isInviteCodeCreateValid();
      allow delete: if isInviteCodeDeleteValid();
    }

    match /apps/worth-the-wait/spaces/{spaceId} {
      function isCreator(data) {
        return request.auth != null && request.auth.uid == data.createdBy;
      }

      function isMember(data) {
        return request.auth != null && request.auth.uid in data.members;
      }

      function isEncryptionConfigValid() {
        return request.resource.data.encryption is map
          && request.resource.data.encryption.appId == 'worth-the-wait'
          && request.resource.data.encryption.keyId is string
          && request.resource.data.encryption.keyId.size() > 0
          && request.resource.data.encryption.keyVersion is number
          && request.resource.data.encryption.key is string
          && request.resource.data.encryption.key.size() > 0;
      }

      function isCreateValid() {
        return request.auth != null
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.pendingMember == null
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() == 6
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.activeAction == null
          && isEncryptionConfigValid();
      }

      function isPendingJoinRequestValid() {
        return request.auth != null
          && request.auth.uid != resource.data.createdBy
          && !(request.auth.uid in resource.data.members)
          && resource.data.members.size() < 2
          && (resource.data.pendingMember == null || resource.data.pendingMember.uid == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMember', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && request.resource.data.welcomeSeenBy == resource.data.welcomeSeenBy
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.pendingMember != null
          && request.resource.data.pendingMember.uid == request.auth.uid
          && request.resource.data.pendingMember.requestedAt is number
          && request.resource.data.updatedAt is number;
      }

      function isApprovalValid() {
        return request.auth != null
          && request.auth.uid == resource.data.createdBy
          && resource.data.pendingMember != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'pendingMember', 'inviteCode', 'activeAction', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.pendingMember == null
          && request.resource.data.inviteCode == null
          && request.resource.data.activeAction == null
          && request.resource.data.welcomeSeenBy == resource.data.welcomeSeenBy
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.hasAll([resource.data.pendingMember.uid])
          && request.resource.data.updatedAt is number;
      }

      function isDeclineValid() {
        return request.auth != null
          && request.auth.uid == resource.data.createdBy
          && resource.data.pendingMember != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pendingMember', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.pendingMember == null
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && request.resource.data.welcomeSeenBy == resource.data.welcomeSeenBy
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.updatedAt is number;
      }

      function isWelcomeSeenUpdateValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['welcomeSeenBy', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.pendingMember == resource.data.pendingMember
          && request.resource.data.activeAction == resource.data.activeAction
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.updatedAt is number
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.welcomeSeenBy[request.auth.uid] is number;
      }

      function isActiveActionStartValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.pendingMember == resource.data.pendingMember
          && request.resource.data.activeAction != null
          && request.resource.data.activeAction.initiatedBy == request.auth.uid
          && request.resource.data.activeAction.status == 'initiating';
      }

      allow read: if isMember(resource.data);

      allow create: if isCreateValid();

      allow update: if (
        isPendingJoinRequestValid() ||
        (isCreator(resource.data) && (isApprovalValid() || isDeclineValid())) ||
        isWelcomeSeenUpdateValid() ||
        isActiveActionStartValid() ||
        (
          isMember(resource.data)
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.pendingMember == resource.data.pendingMember
          && request.resource.data.activeAction == resource.data.activeAction
          && isEncryptionConfigValid()
        )
      );

      allow delete: if isCreator(resource.data);

      match /memberUpdates/{userId} {
        function isCurrentSpaceMember() {
          return request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isMemberUpdateShapeValid() {
          return request.resource.data.userId == userId
            && request.resource.data.createdBoxes is number
            && request.resource.data.updatedBoxes is number
            && request.resource.data.newItems is number
            && request.resource.data.newReveals is number
            && request.resource.data.lastSurfacedAt is number
            && request.resource.data.updatedAt is number;
        }

        allow read: if isCurrentSpaceMember();
        allow create, update: if isCurrentSpaceMember() && isMemberUpdateShapeValid();
        allow delete: if false;
      }

      match /boxes/{boxId} {
        function isSpaceMember() {
          return request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isCreator() {
          return request.auth != null &&
            resource.data.createdBy == request.auth.uid
        }

        function isDefaultBox() {
          return resource.data.isDefault
        }

        function isRevealRequestChange() {
          return request.auth != null
            && isSpaceMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealRequestedBy', 'revealHistory'])
            && request.resource.data.revealRequestedBy is list
            && request.resource.data.revealHistory is list;
        }

        allow read, create: if isSpaceMember();
        allow update: if isSpaceMember() && (
          (isCreator() && !isDefaultBox()) ||
          isRevealRequestChange()
        );
        allow delete: if isSpaceMember() && isCreator() && !isDefaultBox();

        match /items/{itemId} {
          function isAuthor() {
            return request.auth != null && resource.data.authorId == request.auth.uid;
          }

          allow read: if isSpaceMember();

          allow create: if isSpaceMember()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.lastEditedAt is number;

          allow update: if isAuthor()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0;

          allow delete: if isAuthor();
        }
      }
    }

    match /apps/{appId} {
      allow read: if !resource.data.isRestricted || (
        request.auth != null && (
          request.auth.uid in resource.data.allowedUsers ||
          request.auth.token.email in resource.data.allowedUsers ||
          isAdmin()
        )
      );
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
