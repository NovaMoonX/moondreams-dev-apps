rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'nova@moondreams.dev'
      );
    }

    function isHouseholdMember(householdId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId))
        && request.auth.uid in get(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)).data.members;
    }

    function isTimestampNumber(value) {
      return value is number;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // `dev` is only ever set by scripts/seeds/core.ts, which refuses to run
    // against anything but a local emulator — so it never appears on a
    // production token. Lets seeded users see every app locally.
    function isDevUser() {
      return request.auth != null && 'dev' in request.auth.token && request.auth.token.dev == true;
    }

    // Field access guarded with `'field' in appData`: an unfiltered list()
    // query (used by admin/dev) fails outright if a rule can't prove it
    // won't throw on a missing field.
    function isAppVisibleToUser(appData) {
      return ('status' in appData) && appData.status == 'public' && (
        !(('isRestricted' in appData) && appData.isRestricted) || (
          request.auth != null
            && ('allowedUsers' in appData)
            && appData.allowedUsers is list
            && (
              request.auth.uid in appData.allowedUsers ||
              request.auth.token.email in appData.allowedUsers
            )
        )
      );
    }

    // Shared read rule for every /apps/{appId} doc, used by each explicit
    // app block plus the generic fallback below.
    function canReadAppDoc(appData) {
      return isAdmin() || isDevUser() || isAppVisibleToUser(appData);
    }

    // Apps below use explicit paths (not a generic wildcard) so each app's
    // rules stay isolated, kept in alphabetical order by app id. A generic
    // /apps/{appId} fallback for apps without a block yet is at the bottom.

    // --- App: nine-lives ---

    match /apps/nine-lives {
      allow read: if canReadAppDoc(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/nine-lives/inviteCodes/{inviteCode} {
      function isInviteCodeShapeValid() {
        return request.resource.data.keys().hasOnly(['householdId'])
          && request.resource.data.householdId is string
          && request.resource.data.householdId.size() > 0;
      }

      function getInviteHouseholdAfter() {
        return getAfter(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId));
      }

      function isInviteCodeCreateValid() {
        return request.auth != null
          && inviteCode.size() == 6
          && isInviteCodeShapeValid()
          && !exists(/databases/$(database)/documents/apps/nine-lives/inviteCodes/$(inviteCode))
          && existsAfter(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId))
          && getInviteHouseholdAfter().data.createdBy == request.auth.uid
          && request.auth.uid in getInviteHouseholdAfter().data.members
          && getInviteHouseholdAfter().data.inviteCode == inviteCode;
      }

      // get() only — a household is joined by knowing its exact code, not
      // by enumerating every code, so listing this collection is denied.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isInviteCodeCreateValid();
      allow update: if false;
      allow delete: if false;
    }

    match /apps/nine-lives/households/{householdId} {
      function isHouseholdIdentityValid() {
        return request.resource.data.id == householdId
          && request.resource.data.createdBy == request.auth.uid;
      }

      function isHouseholdBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      // A member being added must correspond to a real pending request that
      // existed before this write and is deleted in the same commit — the
      // client batch is not itself a security boundary.
      function isApprovedMemberAddition() {
        let addedUids = request.resource.data.members.removeAll(resource.data.members);
        return addedUids.size() == 1
          && exists(/databases/$(database)/documents/apps/nine-lives/pendingRequests/$(addedUids[0] + '_' + householdId))
          && !existsAfter(/databases/$(database)/documents/apps/nine-lives/pendingRequests/$(addedUids[0] + '_' + householdId));
      }

      function isHouseholdUpdateValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members.hasAll(resource.data.members)
          && (
            request.resource.data.members == resource.data.members
              || isApprovedMemberAddition()
          )
          && (request.resource.data.inviteCode == resource.data.inviteCode || resource.data.inviteCode == null)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isHouseholdCreateValid() {
        return request.auth != null
          && isHouseholdIdentityValid()
          && isHouseholdBaseShapeValid();
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if isHouseholdCreateValid();
      allow update: if isHouseholdMember(householdId) && isHouseholdUpdateValid();
      allow delete: if false;
    }

    match /apps/nine-lives/pendingRequests/{requestId} {
      function requestUid() {
        return requestId.split('_')[0];
      }

      function isPendingRequestIdentityValid() {
        return request.resource.data.uid is string && request.resource.data.uid.size() > 0
          && request.resource.data.householdId is string && request.resource.data.householdId.size() > 0
          && requestId == request.resource.data.uid + '_' + request.resource.data.householdId
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.requestedAt is number;
      }

      function isPendingRequestCreateValid() {
        return request.auth != null
          && request.auth.uid == request.resource.data.uid
          && exists(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId))
          && !isHouseholdMember(request.resource.data.householdId)
          // The submitted code must be the household's real invite code —
          // knowing a householdId alone must never be enough to request in.
          && get(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId)).data.inviteCode == request.resource.data.inviteCode
          && isPendingRequestIdentityValid();
      }

      // Path form covers get() on a not-yet-existing request; data-field
      // form lets the "my requests" list query prove list-safety.
      allow read: if request.auth != null && (
        request.auth.uid == requestUid()
          || (resource != null && resource.data.uid == request.auth.uid)
          || (resource != null && isHouseholdMember(resource.data.householdId))
      );
      allow create: if isPendingRequestCreateValid();
      allow delete: if request.auth != null && (
        request.auth.uid == requestUid()
          || (resource != null && isHouseholdMember(resource.data.householdId))
      );
      allow update: if false;
    }

    match /apps/nine-lives/conditionLibrary/{conditionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /apps/nine-lives/households/{householdId}/cats/{catId} {
      function isCatIdentityValid() {
        return request.resource.data.id == catId
          && request.resource.data.householdId == householdId;
      }

      function isCatBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && isTimestampNumber(request.resource.data.dateOfBirth)
          && request.resource.data.isDateOfBirthEstimated is bool
          && isNonEmptyString(request.resource.data.breed)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isCatCreateOwnershipValid() {
        return request.resource.data.createdBy == request.auth.uid
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isCatImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isCatCreateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isCatIdentityValid()
          && isCatBaseShapeValid()
          && isCatCreateOwnershipValid();
      }

      function isCatUpdateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isCatImmutableFieldsValid()
          && isCatBaseShapeValid();
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if isCatCreateValid();
      allow update: if isCatUpdateValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId) && resource.data.createdBy == request.auth.uid;
    }

    match /apps/nine-lives/households/{householdId}/cats/{catId}/conditions/{conditionId} {
      function isConditionIdentityValid() {
        return request.resource.data.id == conditionId
          && request.resource.data.catId == catId;
      }

      function isConditionBaseShapeValid() {
        return (
          request.resource.data.source == 'library' || request.resource.data.source == 'custom'
        )
          && isNonEmptyString(request.resource.data.name)
          && (
            request.resource.data.category == 'illness'
              || request.resource.data.category == 'injury'
              || request.resource.data.category == 'chronic'
              || request.resource.data.category == 'parasite'
              || request.resource.data.category == 'allergy'
              || request.resource.data.category == 'other'
          )
          && isTimestampNumber(request.resource.data.occurredAt)
          && (request.resource.data.resolvedAt == null || isTimestampNumber(request.resource.data.resolvedAt))
          && (request.resource.data.description == null || request.resource.data.description is string)
          && request.resource.data.linkedVisitIds is list
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (
            (request.resource.data.source == 'library' && request.resource.data.libraryConditionId is string && request.resource.data.libraryConditionId.size() > 0)
              || (request.resource.data.source == 'custom' && request.resource.data.libraryConditionId == null)
          );
      }

      function isConditionImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.catId == catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if request.auth != null && isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isConditionIdentityValid()
        && isConditionBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isConditionImmutableFieldsValid()
        && isConditionBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/cats/{catId}/vaccinations/{vaccinationId} {
      function isVaccinationIdentityValid() {
        return request.resource.data.id == vaccinationId
          && request.resource.data.householdId == householdId
          && request.resource.data.catId == catId;
      }

      function isVaccinationBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && isTimestampNumber(request.resource.data.administeredAt)
          && (request.resource.data.expiresAt == null || isTimestampNumber(request.resource.data.expiresAt))
          && (request.resource.data.clinicId == null || request.resource.data.clinicId is string)
          && (request.resource.data.doctorId == null || request.resource.data.doctorId is string)
          && (request.resource.data.lotNumber == null || request.resource.data.lotNumber is string)
          && (request.resource.data.linkedVisitId == null || request.resource.data.linkedVisitId is string)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isVaccinationImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.catId == catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if request.auth != null && isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isVaccinationIdentityValid()
        && isVaccinationBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isVaccinationImmutableFieldsValid()
        && isVaccinationBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/cats/{catId}/weightEntries/{weightEntryId} {
      function isWeightEntryIdentityValid() {
        return request.resource.data.id == weightEntryId
          && request.resource.data.catId == catId;
      }

      function isWeightEntryBaseShapeValid() {
        return request.resource.data.weight is number
          && request.resource.data.weight > 0
          && (request.resource.data.unit == 'lb' || request.resource.data.unit == 'kg')
          && isTimestampNumber(request.resource.data.measuredAt)
          && (request.resource.data.linkedVisitId == null || request.resource.data.linkedVisitId is string)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isWeightEntryImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if request.auth != null && isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isWeightEntryIdentityValid()
        && isWeightEntryBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isWeightEntryImmutableFieldsValid()
        && isWeightEntryBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/cats/{catId}/symptoms/{symptomId} {
      function isSymptomIdentityValid() {
        return request.resource.data.id == symptomId
          && request.resource.data.catId == catId;
      }

      function isSymptomBaseShapeValid() {
        return request.resource.data.description is string
          && request.resource.data.quickTags is list
          && request.resource.data.firstNoticedAt is number
          && (request.resource.data.severity == null || request.resource.data.severity in ['mild', 'moderate', 'severe'])
          && request.resource.data.linkedVisitIds is list
          && (request.resource.data.linkedConditionId == null || request.resource.data.linkedConditionId is string)
          && (request.resource.data.resolvedAt == null || isTimestampNumber(request.resource.data.resolvedAt))
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isSymptomImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if request.auth != null && isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isSymptomIdentityValid()
        && isSymptomBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isSymptomImmutableFieldsValid()
        && isSymptomBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/vetClinics/{clinicId} {
      function isVetClinicIdentityValid() {
        return request.resource.data.id == clinicId
          && request.resource.data.householdId == householdId;
      }

      function isVetClinicBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && (request.resource.data.phone == null || request.resource.data.phone is string)
          && (request.resource.data.address == null || request.resource.data.address is string)
          && (request.resource.data.isEmergency24Hour == null || request.resource.data.isEmergency24Hour is bool)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isVetClinicImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isVetClinicCreateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isVetClinicIdentityValid()
          && isVetClinicBaseShapeValid();
      }

      function isVetClinicUpdateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isVetClinicImmutableFieldsValid()
          && isVetClinicBaseShapeValid();
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if isVetClinicCreateValid();
      allow update: if isVetClinicUpdateValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/doctors/{doctorId} {
      function isDoctorIdentityValid() {
        return request.resource.data.id == doctorId
          && request.resource.data.householdId == householdId
          && request.resource.data.clinicId is string
          && request.resource.data.clinicId.size() > 0;
      }

      function isDoctorBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isDoctorImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.clinicId == resource.data.clinicId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isDoctorCreateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isDoctorIdentityValid()
          && isDoctorBaseShapeValid();
      }

      function isDoctorUpdateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isDoctorImmutableFieldsValid()
          && isDoctorBaseShapeValid();
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if isDoctorCreateValid();
      allow update: if isDoctorUpdateValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/customHealthRecordTypes/{typeId} {
      function isCustomHealthRecordTypeIdentityValid() {
        return request.resource.data.id == typeId
          && request.resource.data.householdId == householdId;
      }

      function isCustomHealthRecordTypeShapeValid() {
        return isNonEmptyString(request.resource.data.label)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isCustomHealthRecordTypeImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomHealthRecordTypeIdentityValid()
        && isCustomHealthRecordTypeShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomHealthRecordTypeImmutableFieldsValid()
        && isCustomHealthRecordTypeShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/healthRecords/{recordId} {
      function isHealthRecordIdentityValid() {
        return request.resource.data.id == recordId
          && request.resource.data.householdId == householdId;
      }

      function isHealthRecordShapeValid() {
        return request.resource.data.catIds is list
          && request.resource.data.catIds.size() > 0
          && isNonEmptyString(request.resource.data.fileURL)
          && (request.resource.data.fileType == 'pdf' || request.resource.data.fileType == 'image')
          && isNonEmptyString(request.resource.data.fileName)
          && (request.resource.data.label == null || request.resource.data.label is string)
          && request.resource.data.recordType in ['lab_result', 'vet_paperwork', 'insurance', 'shelter_adoption', 'prescription', 'microchip_registration', 'miscellaneous', 'custom']
          && (request.resource.data.customRecordTypeId == null || request.resource.data.customRecordTypeId is string)
          && (request.resource.data.recordDate == null || isTimestampNumber(request.resource.data.recordDate))
          && (request.resource.data.linkedVisitId == null || request.resource.data.linkedVisitId is string)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && request.resource.data.uploadedBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (
            request.resource.data.customRecordTypeId == null
              || exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/customHealthRecordTypes/$(request.resource.data.customRecordTypeId))
          )
          && (request.resource.data.recordType != 'custom' || request.resource.data.customRecordTypeId is string);
      }

      function isHealthRecordImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.fileURL == resource.data.fileURL
          && request.resource.data.fileType == resource.data.fileType
          && request.resource.data.fileName == resource.data.fileName
          && request.resource.data.uploadedBy == resource.data.uploadedBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isHealthRecordIdentityValid()
        && isHealthRecordShapeValid()
        && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isHealthRecordImmutableFieldsValid()
        && isHealthRecordShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/visits/{visitId} {
      function isVisitIdentityValid() {
        return request.resource.data.id == visitId
          && request.resource.data.householdId == householdId;
      }

      function isVisitBaseShapeValid() {
        return request.resource.data.catIds is list
          && request.resource.data.catIds.size() > 0
          && request.resource.data.status in ['upcoming', 'completed', 'cancelled']
          && request.resource.data.reason in ['checkup', 'illness', 'accident', 'vaccination', 'follow_up', 'custom']
          && (request.resource.data.customReasonLabel == null || request.resource.data.customReasonLabel is string)
          && (request.resource.data.followUpOfVisitId == null || request.resource.data.followUpOfVisitId is string)
          && (request.resource.data.followUpNote == null || request.resource.data.followUpNote is string)
          && (request.resource.data.title == null || request.resource.data.title is string)
          && isTimestampNumber(request.resource.data.scheduledAt)
          && (request.resource.data.completedAt == null || isTimestampNumber(request.resource.data.completedAt))
          && (request.resource.data.summary == null || request.resource.data.summary is string)
          && request.resource.data.linkedSymptomIds is list
          && request.resource.data.linkedConditionIds is list
          && request.resource.data.linkedHealthRecordIds is list
          && request.resource.data.linkedVaccinationIds is list
          && request.resource.data.linkedWeightEntryIds is list
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (request.resource.data.reason != 'custom' || request.resource.data.customReasonLabel is string)
          && (request.resource.data.reason != 'follow_up' || request.resource.data.followUpOfVisitId is string);
      }

      function isVisitImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isVisitIdentityValid()
        && isVisitBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isVisitImmutableFieldsValid()
        && isVisitBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/expenses/{expenseId} {
      function isExpenseIdentityValid() {
        return request.resource.data.id == expenseId
          && request.resource.data.householdId == householdId;
      }

      function isExpenseBaseShapeValid() {
        return request.resource.data.catIds is list
          && request.resource.data.catIds.size() > 0
          && request.resource.data.category in [
            'adoption_fee', 'insurance', 'food', 'litter', 'vet',
            'grooming', 'supplies', 'medication', 'microchipping', 'spay_neuter', 'other'
          ]
          && (request.resource.data.label == null || request.resource.data.label is string)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.isRecurring is bool
          && (
            request.resource.data.recurrenceInterval == null
              || request.resource.data.recurrenceInterval in ['monthly', 'yearly']
          )
          && (
            request.resource.data.recurrenceEndedAt == null
              || (request.resource.data.isRecurring == true && isTimestampNumber(request.resource.data.recurrenceEndedAt))
          )
          && isTimestampNumber(request.resource.data.incurredAt)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isExpenseImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isExpenseIdentityValid()
        && isExpenseBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isExpenseImmutableFieldsValid()
        && isExpenseBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    // --- App: worth-the-wait ---

    match /apps/worth-the-wait {
      allow read: if canReadAppDoc(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/worth-the-wait/inviteCodes/{inviteCode} {
      function isInviteCodeShapeValid() {
        return request.resource.data.keys().hasOnly(['spaceId'])
          && request.resource.data.spaceId is string
          && request.resource.data.spaceId.size() > 0;
      }

      function getInviteSpaceAfter() {
        return getAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId));
      }

      function isInviteCodeCreateValid() {
        return request.auth != null
          && inviteCode.size() == 6
          && isInviteCodeShapeValid()
          && !exists(/databases/$(database)/documents/apps/worth-the-wait/inviteCodes/$(inviteCode))
          && existsAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId))
          && getInviteSpaceAfter().data.createdBy == request.auth.uid
          && request.auth.uid in getInviteSpaceAfter().data.members
          && getInviteSpaceAfter().data.inviteCode == inviteCode;
      }

      function isInviteCodeDeleteValid() {
        return request.auth != null
          && resource.data.spaceId is string
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId))
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId)).data.createdBy == request.auth.uid;
      }

      // get() only — a space is joined by knowing its exact code, not by
      // enumerating every code, so listing this collection is denied.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isInviteCodeCreateValid();
      allow delete: if isInviteCodeDeleteValid();
    }

    match /apps/worth-the-wait/pendingRequests/{uid} {
      function isPendingRequestIdentityValid() {
        return request.resource.data.uid == uid
          && request.resource.data.spaceId is string
          && request.resource.data.spaceId.size() > 0
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.requestedAt is number;
      }

      function isSpaceMemberForRequest(spaceId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId))
          && request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
      }

      function isPendingRequestCreateValid() {
        return request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId))
          && !isSpaceMemberForRequest(request.resource.data.spaceId)
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId)).data.members.size() < 2
          // The submitted code must be the space's real invite code —
          // knowing a spaceId alone must never be enough to request in.
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId)).data.inviteCode == request.resource.data.inviteCode
          && isPendingRequestIdentityValid();
      }

      // Path-based own-uid check authorizes get() on a request that doesn't
      // exist yet; resource.data.spaceId lets the space-scoped list query
      // (used to review requests for a space) prove list-safety.
      allow read: if request.auth != null && (
        request.auth.uid == uid
          || (resource != null && isSpaceMemberForRequest(resource.data.spaceId))
      );
      allow create: if isPendingRequestCreateValid();
      allow delete: if request.auth != null && (
        request.auth.uid == uid || (resource != null && isSpaceMemberForRequest(resource.data.spaceId))
      );
      allow update: if false;
    }

    match /apps/worth-the-wait/spaces/{spaceId} {
      function isCreator(data) {
        return request.auth != null && request.auth.uid == data.createdBy;
      }

      function isMember(data) {
        return request.auth != null && request.auth.uid in data.members;
      }

      function isEncryptionConfigValid() {
        return request.resource.data.encryption is map
          && request.resource.data.encryption.appId == 'worth-the-wait'
          && request.resource.data.encryption.keyId is string
          && request.resource.data.encryption.keyId.size() > 0
          && request.resource.data.encryption.keyVersion is number
          && request.resource.data.encryption.key is string
          && request.resource.data.encryption.key.size() > 0;
      }

      function isCreateValid() {
        return request.auth != null
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() == 6
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.activeAction == null
          && isEncryptionConfigValid();
      }

      // Which uid is being approved isn't re-checked here; mirrors Nine
      // Lives' isHouseholdUpdateValid, which doesn't cross-check either.
      // A member being added must correspond to a real pending request that
      // existed before this write and is deleted in the same commit — the
      // client batch is not itself a security boundary.
      function isApprovedMemberAddition() {
        let addedUids = request.resource.data.members.removeAll(resource.data.members);
        return addedUids.size() == 1
          && exists(/databases/$(database)/documents/apps/worth-the-wait/pendingRequests/$(addedUids[0]))
          && !existsAfter(/databases/$(database)/documents/apps/worth-the-wait/pendingRequests/$(addedUids[0]));
      }

      function isApprovalValid() {
        return request.auth != null
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'inviteCode', 'activeAction', 'welcomeSeenBy', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.inviteCode == null
          && request.resource.data.activeAction == null
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && isApprovedMemberAddition()
          && request.resource.data.updatedAt is number;
      }

      function isWelcomeSeenUpdateValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['welcomeSeenBy', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.updatedAt is number
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.welcomeSeenBy[request.auth.uid] is number;
      }

      function isActiveActionStartValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction != null
          && request.resource.data.activeAction.initiatedBy == request.auth.uid
          && request.resource.data.activeAction.status == 'initiating';
      }

      // Member-only: this doc carries the encryption key, so a pending
      // requester must never read it (join state lives in pendingRequests).
      allow read: if isMember(resource.data);

      allow create: if isCreateValid();

      allow update: if (
        (isCreator(resource.data) && isApprovalValid()) ||
        isWelcomeSeenUpdateValid() ||
        isActiveActionStartValid() ||
        (
          isMember(resource.data)
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && isEncryptionConfigValid()
        )
      );

      allow delete: if isCreator(resource.data);

      match /memberUpdates/{userId} {
        function isCurrentSpaceMember() {
          return request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isMemberUpdateShapeValid() {
          return request.resource.data.userId == userId
            && request.resource.data.createdBoxes is number
            && request.resource.data.updatedBoxes is number
            && request.resource.data.newItems is number
            && request.resource.data.lastSurfacedAt is number
            && request.resource.data.updatedAt is number;
        }

        allow read: if isCurrentSpaceMember();
        allow create, update: if isCurrentSpaceMember() && isMemberUpdateShapeValid();
        allow delete: if false;
      }

      match /boxes/{boxId} {
        function isSpaceMember() {
          return request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isCreator() {
          return request.auth != null &&
            resource.data.createdBy == request.auth.uid
        }

        function isDefaultBox() {
          return resource.data.isDefault
        }

        function isRevealRequestChange() {
          return request.auth != null
            && isSpaceMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealRequestedBy', 'revealHistory'])
            && request.resource.data.revealRequestedBy is list
            && request.resource.data.revealHistory is list;
        }

        allow read, create: if isSpaceMember();
        allow update: if isSpaceMember() && (
          (isCreator() && !isDefaultBox()) ||
          isRevealRequestChange()
        );
        allow delete: if isSpaceMember() && isCreator() && !isDefaultBox();

        match /items/{itemId} {
          function isAuthor() {
            return request.auth != null && resource.data.authorId == request.auth.uid;
          }

          allow read: if isSpaceMember();

          allow create: if isSpaceMember()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.lastEditedAt is number;

          allow update: if isAuthor()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0;

          allow delete: if isAuthor();
        }
      }
    }

    // Fallback for any app doc that doesn't have an explicit /apps/{appId}
    // block above — same rule as every explicit app block, so a new app
    // works correctly even before it's given its own block.
    match /apps/{appId} {
      allow read: if canReadAppDoc(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
