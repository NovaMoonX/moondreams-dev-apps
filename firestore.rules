rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        (('admin' in request.auth.token) && request.auth.token.admin == true) ||
        request.auth.token.email == 'nova@moondreams.dev'
      );
    }

    function isHouseholdMember(householdId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId))
        && request.auth.uid in get(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)).data.members;
    }

    function isTimestampNumber(value) {
      return value is number;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // Trips are judged by calendar day, and `endDate` is the UTC midnight that starts the last
    // day — so the trip stays active through that whole day.
    function isTripActive(trip) {
      return request.time.toMillis() >= trip.startDate && request.time.toMillis() < trip.endDate + 86400000;
    }

    // True once a trip has started, whether it's still ongoing or already over — used to
    // narrow who can add brand-new events/stays once a trip's plan is actually underway.
    function hasTripStarted(trip) {
      return request.time.toMillis() >= trip.startDate;
    }

    // Links are rendered as hrefs, so only http(s) is allowed — never `javascript:` or `data:`.
    function isHttpUrl(value) {
      return value is string && value.matches('^https?://[^\\s]+$');
    }

    function isClockTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // Trips created before relative times have no `timeModel`; they store events and stays as
    // absolute timestamps and can't have their dates changed.
    function isRelativeTrip(trip) {
      return trip.get('timeModel', null) == 'RELATIVE';
    }

    // `dev` is only ever set by scripts/seeds/core.ts, which refuses to run
    // against anything but a local emulator — so it never appears on a
    // production token. Lets seeded users see every app locally.
    function isDevUser() {
      return request.auth != null && 'dev' in request.auth.token && request.auth.token.dev == true;
    }

    // Each predicate is its own `allow read`, not OR'd together — Firestore's
    // list() safety check can't prove a combined expression once a query mixes
    // equality filters with array-contains, and denies reads get() allows fine.
    // Only `status` is existence-guarded; short-circuit order protects the rest.
    function isUnrestrictedPublicApp(appData) {
      return ('status' in appData) && appData.status == 'public' && appData.isRestricted != true;
    }

    function isUidAllowedApp(appData) {
      return ('status' in appData) && appData.status == 'public' && appData.isRestricted == true
        && request.auth != null
        && request.auth.uid in appData.allowedUsers;
    }

    function isEmailAllowedApp(appData) {
      return ('status' in appData) && appData.status == 'public' && appData.isRestricted == true
        && request.auth != null && ('email' in request.auth.token)
        && request.auth.token.email in appData.allowedUsers;
    }

    // Apps below use explicit paths (not a generic wildcard) so each app's
    // rules stay isolated, kept in alphabetical order by app id. A generic
    // /apps/{appId} fallback for apps without a block yet is at the bottom.

    // --- App: a-list ---

    match /apps/a-list {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    // Every A-List document is private to one member and nests under their uid.
    match /apps/a-list/memberships/{uid} {
      function isMembershipOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function isCents(value) {
        return value is int && value >= 0 && value <= 1000000;
      }

      function isNullOrIntBetween(value, low, high) {
        return value == null || (value is int && value >= low && value <= high);
      }

      // Whole or half stars: legacy 1–5 whole-star ratings stay valid.
      function isNullOrHalfStars(value) {
        return value == null || (value is number && value >= 0.5 && value <= 5 && value * 2 == int(value * 2));
      }

      function isNullOrTaxRate(value) {
        return value == null || (value is number && value >= 0 && value <= 0.25);
      }

      function isTheatreId(value) {
        return value is string && value.matches('^manual-[A-Za-z0-9-]{8,40}$');
      }

      function isMembershipValid(data) {
        let keys = ['uid', 'monthlyCostCents', 'monthlyTotalCents', 'taxRate', 'startDate',
                    'weeklyGoal', 'monthlyGoal', 'setupCompletedAt', 'createdAt', 'lastEditedAt'];
        // `favoriteTheatreId` arrived later: legacy documents lack it, so it is allowed but not required.
        return data.keys().hasOnly(keys.concat(['favoriteTheatreId'])) && data.keys().hasAll(keys)
          && (data.get('favoriteTheatreId', null) == null || isTheatreId(data.favoriteTheatreId))
          && data.uid == uid
          && isCents(data.monthlyCostCents) && data.monthlyCostCents > 0
          && isCents(data.monthlyTotalCents)
          && data.monthlyTotalCents >= data.monthlyCostCents
          && isNullOrTaxRate(data.taxRate)
          && data.startDate is int
          && isNullOrIntBetween(data.weeklyGoal, 1, 21)
          && isNullOrIntBetween(data.monthlyGoal, 1, 93)
          && data.setupCompletedAt is int
          && data.createdAt is int
          && data.lastEditedAt is int;
      }

      allow read: if isMembershipOwner();
      allow create: if isMembershipOwner() && isMembershipValid(request.resource.data);
      allow update: if isMembershipOwner() && isMembershipValid(request.resource.data)
        && request.resource.data.setupCompletedAt == resource.data.setupCompletedAt
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      function isOptionalText(value, maxSize) {
        return value == null || (value is string && value.size() > 0 && value.size() <= maxSize);
      }

      function isTheatreSnapshotValid(theatre) {
        let keys = ['theatreId', 'name', 'city', 'state'];
        return theatre is map && theatre.keys().hasOnly(keys) && theatre.keys().hasAll(keys)
          && isTheatreId(theatre.theatreId)
          && theatre.name is string && theatre.name.size() > 0 && theatre.name.size() <= 120
          && isOptionalText(theatre.city, 80)
          && isOptionalText(theatre.state, 40);
      }

      match /theatres/{theatreId} {
        function isTheatreValid(data) {
          let keys = ['theatreId', 'name', 'addressLine', 'city', 'state', 'postalCode',
                      'latitude', 'longitude', 'createdAt', 'lastEditedAt'];
          return data.keys().hasOnly(keys) && data.keys().hasAll(keys)
            && data.theatreId == theatreId
            && isTheatreId(theatreId)
            && data.name is string && data.name.size() > 0 && data.name.size() <= 120
            && isOptionalText(data.addressLine, 200)
            && isOptionalText(data.city, 80)
            && isOptionalText(data.state, 40)
            && isOptionalText(data.postalCode, 20)
            && (data.latitude == null || (data.latitude is number && data.latitude >= -90 && data.latitude <= 90))
            && (data.longitude == null || (data.longitude is number && data.longitude >= -180 && data.longitude <= 180))
            && data.createdAt is int
            && data.lastEditedAt is int;
        }

        allow read, delete: if isMembershipOwner();
        allow create: if isMembershipOwner() && isTheatreValid(request.resource.data);
        allow update: if isMembershipOwner() && isTheatreValid(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isMovieValid(movie) {
        let keys = ['title', 'releaseDate', 'posterUrl', 'runtimeMinutes', 'contentRating'];
        return movie is map && movie.keys().hasOnly(keys) && movie.keys().hasAll(keys)
          && movie.title is string && movie.title.size() > 0 && movie.title.size() <= 200
          && (movie.releaseDate == null || movie.releaseDate is int)
          && (movie.posterUrl == null || (movie.posterUrl is string && movie.posterUrl.size() <= 500
            && movie.posterUrl.matches('^https://[^\\s]+$')))
          && isNullOrIntBetween(movie.runtimeMinutes, 1, 1000)
          && (movie.contentRating == null || (movie.contentRating is string && movie.contentRating.size() <= 20));
      }

      function isTicketValid(ticket) {
        let keys = ['entryMode', 'format', 'priceCents', 'standardPriceCents', 'feeAvoidedCents',
                    'taxRate', 'taxCents', 'totalCents'];
        return ticket is map && ticket.keys().hasOnly(keys) && ticket.keys().hasAll(keys)
          && ticket.entryMode in ['ITEMIZED', 'ALL_IN']
          && isFormat(ticket.format)
          && isCents(ticket.priceCents)
          && (ticket.standardPriceCents == null || isCents(ticket.standardPriceCents))
          && (ticket.format != 'STANDARD' || ticket.standardPriceCents == null)
          && isCents(ticket.feeAvoidedCents)
          && isNullOrTaxRate(ticket.taxRate)
          && isCents(ticket.taxCents)
          && isCents(ticket.totalCents)
          && ticket.totalCents == ticket.priceCents + ticket.feeAvoidedCents + ticket.taxCents;
      }

      function isFormat(value) {
        return value in ['STANDARD', 'DOLBY_CINEMA', 'IMAX', 'PRIME', 'REALD_3D', 'LASER'];
      }

      match /watchlist/{movieKey} {
        function isWatchlistItemValid(data) {
          let keys = ['movieKey', 'movie', 'priority', 'preferredFormat', 'createdAt', 'lastEditedAt'];
          return data.keys().hasOnly(keys) && data.keys().hasAll(keys)
            && data.movieKey == movieKey
            && movieKey.matches('^(imdb-tt[0-9]{7,10}|tmdb-[0-9]{1,9}|manual-[A-Za-z0-9-]{8,40})$')
            && isMovieValid(data.movie)
            && data.priority in ['MUST_SEE', 'WANT_TO_SEE', 'IF_I_HAVE_TIME']
            && (data.preferredFormat == null || isFormat(data.preferredFormat))
            && data.createdAt is int
            && data.lastEditedAt is int;
        }

        allow read, delete: if isMembershipOwner();
        allow create: if isMembershipOwner() && isWatchlistItemValid(request.resource.data);
        allow update: if isMembershipOwner() && isWatchlistItemValid(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      match /viewings/{viewingId} {
        function isViewingValid(data) {
          let required = ['id', 'movieKey', 'movie', 'showtimeAt', 'endsAt', 'status', 'createdAt', 'lastEditedAt'];
          // `ticket`, `rating`, `theatre` and `trailerReminderId` arrived later: legacy documents lack them, so they're allowed but not required.
          return data.keys().hasOnly(required.concat(['ticket', 'rating', 'theatre', 'trailerReminderId'])) && data.keys().hasAll(required)
            && data.id == viewingId
            && data.movieKey is string
            && data.movieKey.matches('^(imdb-tt[0-9]{7,10}|tmdb-[0-9]{1,9}|manual-[A-Za-z0-9-]{8,40})$')
            && isMovieValid(data.movie)
            && data.showtimeAt is int
            && data.endsAt is int && data.endsAt > data.showtimeAt
            && data.status in ['PLANNED', 'SEEN']
            // The server's clock, so a skewed device can't record a future showing as seen.
            && (data.status == 'PLANNED' || data.showtimeAt <= request.time.toMillis())
            && (data.get('ticket', null) == null || isTicketValid(data.ticket))
            && (data.get('theatre', null) == null || isTheatreSnapshotValid(data.theatre))
            && (data.get('trailerReminderId', null) == null || data.trailerReminderId is string)
            && isNullOrHalfStars(data.get('rating', null))
            && (data.status == 'SEEN' || data.get('rating', null) == null)
            && data.createdAt is int
            && data.lastEditedAt is int;
        }

        function arrivesAsSeen(data) {
          return data.status == 'SEEN' && data.endsAt <= request.time.toMillis();
        }

        allow read, delete: if isMembershipOwner();
        allow create: if isMembershipOwner() && isViewingValid(request.resource.data)
          && (request.resource.data.status == 'PLANNED' || arrivesAsSeen(request.resource.data));
        allow update: if isMembershipOwner() && isViewingValid(request.resource.data)
          && request.resource.data.movieKey == resource.data.movieKey
          && request.resource.data.movie == resource.data.movie
          && request.resource.data.createdAt == resource.data.createdAt
          // A seen viewing never goes back to planned; planned only becomes seen once it has ended.
          && (resource.data.status == 'SEEN'
            ? request.resource.data.status == 'SEEN'
            : (request.resource.data.status == 'PLANNED' || arrivesAsSeen(request.resource.data)));
      }
    }

    // Written and read only by the movie-lookup Cloud Functions (admin SDK), so no client
    // can read another member's usage counters or poison the shared cache.
    match /apps/a-list/searchCache/{key} {
      allow read, write: if false;
    }

    match /apps/a-list/movieCache/{key} {
      allow read, write: if false;
    }

    match /apps/a-list/lookupUsage/{key} {
      allow read, write: if false;
    }

    // A calendar share is addressed by an unguessable id, so it can't nest under the owner's uid;
    // `ownerUid` stands in. Visitors never read it: a server function checks the PIN with the
    // admin SDK and returns only the allowlisted fields.
    match /apps/a-list/calendarShares/{shareId} {
      function isShareOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }

      function isSharePin(value) {
        return value == null || (value is string && value.matches('^[2-9A-HJ-NP-Z]{4}$'));
      }

      function isShareCreateValid(data) {
        let keys = ['id', 'ownerUid', 'startDate', 'endDate', 'pin', 'viewings', 'createdAt', 'lastEditedAt'];
        return data.keys().hasOnly(keys) && data.keys().hasAll(keys)
          && data.id == shareId
          && shareId.matches('^[2-9a-hj-np-z]{26}$')
          && data.ownerUid == request.auth.uid
          && data.startDate is int && data.endDate is int
          && data.endDate >= data.startDate
          && data.endDate - data.startDate <= 365 * 86400000
          && isSharePin(data.pin)
          && data.viewings is list && data.viewings.size() > 0 && data.viewings.size() <= 400
          && data.createdAt is int
          && data.lastEditedAt is int;
      }

      // A share is a snapshot: the only thing the owner can change afterwards is its PIN.
      function isShareUpdateValid() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin', 'lastEditedAt'])
          && isSharePin(request.resource.data.pin)
          && request.resource.data.lastEditedAt is int;
      }

      allow read, delete: if isShareOwner();
      allow create: if request.auth != null && isShareCreateValid(request.resource.data)
        && exists(/databases/$(database)/documents/apps/a-list/memberships/$(request.auth.uid));
      allow update: if isShareOwner() && isShareUpdateValid();
    }

    // --- App: nine-lives ---

    match /apps/nine-lives {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/nine-lives/inviteCodes/{inviteCode} {
      function isInviteCodeShapeValid() {
        return request.resource.data.keys().hasOnly(['householdId'])
          && request.resource.data.householdId is string
          && request.resource.data.householdId.size() > 0;
      }

      function getInviteHouseholdAfter() {
        return getAfter(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId));
      }

      function isInviteCodeCreateValid() {
        return request.auth != null
          && inviteCode.size() == 6
          && isInviteCodeShapeValid()
          && !exists(/databases/$(database)/documents/apps/nine-lives/inviteCodes/$(inviteCode))
          && existsAfter(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId))
          && getInviteHouseholdAfter().data.createdBy == request.auth.uid
          && request.auth.uid in getInviteHouseholdAfter().data.members
          && getInviteHouseholdAfter().data.inviteCode == inviteCode;
      }

      // get() only — a household is joined by knowing its exact code, not
      // by enumerating every code, so listing this collection is denied.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isInviteCodeCreateValid();
      allow update: if false;
      allow delete: if false;
    }

    match /apps/nine-lives/households/{householdId} {
      function isHouseholdIdentityValid() {
        return request.resource.data.id == householdId
          && request.resource.data.createdBy == request.auth.uid;
      }

      function isHouseholdBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      // A member being added must correspond to a real pending request that
      // existed before this write and is deleted in the same commit — the
      // client batch is not itself a security boundary.
      function isApprovedMemberAddition() {
        let addedUids = request.resource.data.members.removeAll(resource.data.members);
        return addedUids.size() == 1
          && exists(/databases/$(database)/documents/apps/nine-lives/pendingRequests/$(addedUids[0] + '_' + householdId))
          && !existsAfter(/databases/$(database)/documents/apps/nine-lives/pendingRequests/$(addedUids[0] + '_' + householdId));
      }

      function isHouseholdUpdateValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members.hasAll(resource.data.members)
          && (
            request.resource.data.members == resource.data.members
              || isApprovedMemberAddition()
          )
          && (request.resource.data.inviteCode == resource.data.inviteCode || resource.data.inviteCode == null)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isHouseholdCreateValid() {
        return request.auth != null
          && isHouseholdIdentityValid()
          && isHouseholdBaseShapeValid();
      }

      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if isHouseholdCreateValid();
      allow update: if isHouseholdMember(householdId) && isHouseholdUpdateValid();
      allow delete: if false;
    }

    match /apps/nine-lives/pendingRequests/{requestId} {
      function requestUid() {
        return requestId.split('_')[0];
      }

      function isPendingRequestIdentityValid() {
        return request.resource.data.uid is string && request.resource.data.uid.size() > 0
          && request.resource.data.householdId is string && request.resource.data.householdId.size() > 0
          && requestId == request.resource.data.uid + '_' + request.resource.data.householdId
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.requestedAt is number;
      }

      function isPendingRequestCreateValid() {
        return request.auth != null
          && request.auth.uid == request.resource.data.uid
          && exists(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId))
          && !isHouseholdMember(request.resource.data.householdId)
          // The submitted code must be the household's real invite code —
          // knowing a householdId alone must never be enough to request in.
          && get(/databases/$(database)/documents/apps/nine-lives/households/$(request.resource.data.householdId)).data.inviteCode == request.resource.data.inviteCode
          && isPendingRequestIdentityValid();
      }

      // Path form covers get() on a not-yet-existing request; data-field
      // form lets the "my requests" list query prove list-safety.
      allow read: if request.auth != null && (
        request.auth.uid == requestUid()
          || (resource != null && resource.data.uid == request.auth.uid)
          || (resource != null && isHouseholdMember(resource.data.householdId))
      );
      allow create: if isPendingRequestCreateValid();
      allow delete: if request.auth != null && (
        request.auth.uid == requestUid()
          || (resource != null && isHouseholdMember(resource.data.householdId))
      );
      allow update: if false;
    }

    match /apps/nine-lives/conditionLibrary/{conditionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /apps/nine-lives/households/{householdId}/cats/{catId} {
      function isCatIdentityValid() {
        return request.resource.data.id == catId
          && request.resource.data.householdId == householdId;
      }

      function isCatBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && isTimestampNumber(request.resource.data.dateOfBirth)
          && request.resource.data.isDateOfBirthEstimated is bool
          && isNonEmptyString(request.resource.data.breed)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isCatCreateOwnershipValid() {
        return request.resource.data.createdBy == request.auth.uid
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isCatImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isCatCreateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isCatIdentityValid()
          && isCatBaseShapeValid()
          && isCatCreateOwnershipValid();
      }

      function isCatUpdateValid() {
        return request.auth != null
          && isHouseholdMember(householdId)
          && isCatImmutableFieldsValid()
          && isCatBaseShapeValid();
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if isCatCreateValid();
      allow update: if isCatUpdateValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId) && resource.data.createdBy == request.auth.uid;
    }

    match /apps/nine-lives/households/{householdId}/conditions/{conditionId} {
      function isConditionIdentityValid() {
        return request.resource.data.id == conditionId
          && request.resource.data.catId is string;
      }

      function isConditionBaseShapeValid() {
        return (
          request.resource.data.source == 'library' || request.resource.data.source == 'custom'
        )
          && isNonEmptyString(request.resource.data.name)
          && (
            request.resource.data.category == 'illness'
              || request.resource.data.category == 'injury'
              || request.resource.data.category == 'chronic'
              || request.resource.data.category == 'parasite'
              || request.resource.data.category == 'allergy'
          )
          && isTimestampNumber(request.resource.data.occurredAt)
          && (request.resource.data.resolvedAt == null || isTimestampNumber(request.resource.data.resolvedAt))
          && (request.resource.data.description == null || request.resource.data.description is string)
          && request.resource.data.linkedVisitIds is list
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (
            (request.resource.data.source == 'library' && request.resource.data.libraryConditionId is string && request.resource.data.libraryConditionId.size() > 0)
              || (request.resource.data.source == 'custom' && request.resource.data.libraryConditionId == null)
          );
      }

      function isConditionImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.catId == resource.data.catId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isConditionIdentityValid()
        && isConditionBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isConditionImmutableFieldsValid()
        && isConditionBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/vaccinations/{vaccinationId} {
      function isVaccinationIdentityValid() {
        return request.resource.data.id == vaccinationId
          && request.resource.data.householdId == householdId
          && request.resource.data.catId is string;
      }

      function isVaccinationBaseShapeValid() {
        return isNonEmptyString(request.resource.data.name)
          && request.resource.data.history is list
          && request.resource.data.history.size() > 0
          && isTimestampNumber(request.resource.data.firstAdministeredAt)
          && isTimestampNumber(request.resource.data.lastAdministeredAt)
          && (request.resource.data.expiresAt == null || isTimestampNumber(request.resource.data.expiresAt))
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

