          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterBoxIdentityValid()
        && isLitterBoxBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterBoxImmutableFieldsValid()
        && isLitterBoxBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/customLitterTypes/{typeId} {
      function isCustomLitterTypeIdentityValid() {
        return request.resource.data.id == typeId
          && request.resource.data.householdId == householdId;
      }

      function isCustomLitterTypeShapeValid() {
        return isNonEmptyString(request.resource.data.label)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      function isCustomLitterTypeImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomLitterTypeIdentityValid()
        && isCustomLitterTypeShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isCustomLitterTypeImmutableFieldsValid()
        && isCustomLitterTypeShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/litters/{litterId} {
      function isLitterIdentityValid() {
        return request.resource.data.id == litterId
          && request.resource.data.householdId == householdId;
      }

      function isLitterBaseShapeValid() {
        return isNonEmptyString(request.resource.data.brand)
          && request.resource.data.litterType in [
            'clumping_clay', 'non_clumping_clay', 'pine_wood_pellet', 'paper',
            'crystal_silica', 'corn', 'wheat', 'walnut', 'custom'
          ]
          && (request.resource.data.customLitterTypeId == null || request.resource.data.customLitterTypeId is string)
          && request.resource.data.weight is number
          && request.resource.data.weight > 0
          && request.resource.data.weightUnit in ['lb', 'kg']
          && (request.resource.data.cost == null || (request.resource.data.cost is number && request.resource.data.cost >= 0))
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (request.resource.data.litterType != 'custom' || isNonEmptyString(request.resource.data.customLitterTypeId))
          && (
            request.resource.data.customLitterTypeId == null
              || exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/customLitterTypes/$(request.resource.data.customLitterTypeId))
          );
      }

      function isLitterImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterIdentityValid()
        && isLitterBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterImmutableFieldsValid()
        && isLitterBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    match /apps/nine-lives/households/{householdId}/litterEntries/{entryId} {
      function isLitterEntryIdentityValid() {
        return request.resource.data.id == entryId
          && request.resource.data.householdId == householdId;
      }

      function isLitterEntryBaseShapeValid() {
        return isNonEmptyString(request.resource.data.litterBoxId)
          && isNonEmptyString(request.resource.data.litterId)
          && request.resource.data.weightBefore is number
          && request.resource.data.weightBefore > 0
          && request.resource.data.weightUnit in ['lb', 'kg']
          && (request.resource.data.refillWeight == null || (request.resource.data.refillWeight is number && request.resource.data.refillWeight > 0))
          && request.resource.data.isFullChange is bool
          && (request.resource.data.isFullChange == false || request.resource.data.refillWeight != null)
          && isTimestampNumber(request.resource.data.loggedAt)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/litterBoxes/$(request.resource.data.litterBoxId))
          && exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/litters/$(request.resource.data.litterId));
      }

      function isLitterEntryImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterEntryIdentityValid()
        && isLitterEntryBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterEntryImmutableFieldsValid()
        && isLitterEntryBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    // --- App: worth-the-wait ---

    match /apps/worth-the-wait {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/worth-the-wait/inviteCodes/{inviteCode} {
      function isInviteCodeShapeValid() {
        return request.resource.data.keys().hasOnly(['spaceId'])
          && request.resource.data.spaceId is string
          && request.resource.data.spaceId.size() > 0;
      }

      function getInviteSpaceAfter() {
        return getAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId));
      }

      function isInviteCodeCreateValid() {
        return request.auth != null
          && inviteCode.size() == 6
          && isInviteCodeShapeValid()
          && !exists(/databases/$(database)/documents/apps/worth-the-wait/inviteCodes/$(inviteCode))
          && existsAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId))
          && getInviteSpaceAfter().data.createdBy == request.auth.uid
          && request.auth.uid in getInviteSpaceAfter().data.members
          && getInviteSpaceAfter().data.inviteCode == inviteCode;
      }

      function isInviteCodeDeleteValid() {
        return request.auth != null
          && resource.data.spaceId is string
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId))
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId)).data.createdBy == request.auth.uid;
      }

      // get() only — a space is joined by knowing its exact code, not by
      // enumerating every code, so listing this collection is denied.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isInviteCodeCreateValid();
      allow delete: if isInviteCodeDeleteValid();
    }

    match /apps/worth-the-wait/pendingRequests/{uid} {
      function isPendingRequestIdentityValid() {
        return request.resource.data.uid == uid
          && request.resource.data.spaceId is string
          && request.resource.data.spaceId.size() > 0
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.requestedAt is number;
      }

      function isSpaceMemberForRequest(spaceId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId))
          && request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
      }

      function isPendingRequestCreateValid() {
        return request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId))
          && !isSpaceMemberForRequest(request.resource.data.spaceId)
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId)).data.members.size() < 2
          // The submitted code must be the space's real invite code —
          // knowing a spaceId alone must never be enough to request in.
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId)).data.inviteCode == request.resource.data.inviteCode
          && isPendingRequestIdentityValid();
      }

      // Path-based own-uid check authorizes get() on a request that doesn't
      // exist yet; resource.data.spaceId lets the space-scoped list query
      // (used to review requests for a space) prove list-safety.
      allow read: if request.auth != null && (
        request.auth.uid == uid
          || (resource != null && isSpaceMemberForRequest(resource.data.spaceId))
      );
      allow create: if isPendingRequestCreateValid();
      allow delete: if request.auth != null && (
        request.auth.uid == uid || (resource != null && isSpaceMemberForRequest(resource.data.spaceId))
      );
      allow update: if false;
    }

    match /apps/worth-the-wait/spaces/{spaceId} {
      function isCreator(data) {
        return request.auth != null && request.auth.uid == data.createdBy;
      }

      function isMember(data) {
        return request.auth != null && request.auth.uid in data.members;
      }

      function isEncryptionConfigValid() {
        return request.resource.data.encryption is map
          && request.resource.data.encryption.appId == 'worth-the-wait'
          && request.resource.data.encryption.keyId is string
          && request.resource.data.encryption.keyId.size() > 0
          && request.resource.data.encryption.keyVersion is number
          && request.resource.data.encryption.key is string
          && request.resource.data.encryption.key.size() > 0;
      }

      function isCreateValid() {
        return request.auth != null
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() == 6
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.activeAction == null
          && isEncryptionConfigValid();
      }

      // Which uid is being approved isn't re-checked here; mirrors Nine
      // Lives' isHouseholdUpdateValid, which doesn't cross-check either.
      // A member being added must correspond to a real pending request that
      // existed before this write and is deleted in the same commit — the
      // client batch is not itself a security boundary.
      function isApprovedMemberAddition() {
        let addedUids = request.resource.data.members.removeAll(resource.data.members);
        return addedUids.size() == 1
          && exists(/databases/$(database)/documents/apps/worth-the-wait/pendingRequests/$(addedUids[0]))
          && !existsAfter(/databases/$(database)/documents/apps/worth-the-wait/pendingRequests/$(addedUids[0]));
      }

      function isApprovalValid() {
        return request.auth != null
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'inviteCode', 'activeAction', 'welcomeSeenBy', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.inviteCode == null
          && request.resource.data.activeAction == null
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && isApprovedMemberAddition()
          && request.resource.data.updatedAt is number;
      }

      function isWelcomeSeenUpdateValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['welcomeSeenBy', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.updatedAt is number
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.welcomeSeenBy[request.auth.uid] is number;
      }

      function isActiveActionStartValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction != null
          && request.resource.data.activeAction.initiatedBy == request.auth.uid
          && request.resource.data.activeAction.status == 'initiating';
      }

      // Member-only: this doc carries the encryption key, so a pending
      // requester must never read it (join state lives in pendingRequests).
      allow read: if isMember(resource.data);

      allow create: if isCreateValid();

      allow update: if (
        (isCreator(resource.data) && isApprovalValid()) ||
        isWelcomeSeenUpdateValid() ||
        isActiveActionStartValid() ||
        (
          isMember(resource.data)
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && isEncryptionConfigValid()
        )
      );

      allow delete: if isCreator(resource.data);

      match /memberUpdates/{userId} {
        function isCurrentSpaceMember() {
          return request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isMemberUpdateShapeValid() {
          return request.resource.data.userId == userId
            && request.resource.data.createdBoxes is number
            && request.resource.data.updatedBoxes is number
            && request.resource.data.newItems is number
            && request.resource.data.lastSurfacedAt is number
            && request.resource.data.updatedAt is number;
        }

        allow read: if isCurrentSpaceMember();
        allow create, update: if isCurrentSpaceMember() && isMemberUpdateShapeValid();
        allow delete: if false;
      }

      match /boxes/{boxId} {
        function isSpaceMember() {
          return request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isCreator() {
          return request.auth != null &&
            resource.data.createdBy == request.auth.uid
        }

        function isDefaultBox() {
          return resource.data.isDefault
        }

        function isRevealRequestChange() {
          return request.auth != null
            && isSpaceMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealRequestedBy', 'revealHistory'])
            && request.resource.data.revealRequestedBy is list
            && request.resource.data.revealHistory is list;
        }

        allow read, create: if isSpaceMember();
        allow update: if isSpaceMember() && (
          (isCreator() && !isDefaultBox()) ||
          isRevealRequestChange()
        );
        allow delete: if isSpaceMember() && isCreator() && !isDefaultBox();

        match /items/{itemId} {
          function isAuthor() {
            return request.auth != null && resource.data.authorId == request.auth.uid;
          }

          allow read: if isSpaceMember();

          allow create: if isSpaceMember()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.lastEditedAt is number;

          allow update: if isAuthor()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0;

          allow delete: if isAuthor();
        }
      }
    }

        // --- App: waypoint ---

    match /apps/waypoint {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/waypoint/inviteCodes/{inviteCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['tripId', 'title'])
        && request.resource.data.tripId is string
        && isNonEmptyString(request.resource.data.title)
        && existsAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId))
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId)).data.title == request.resource.data.title
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId)).data.inviteCode == inviteCode;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title'])
        && request.resource.data.tripId == resource.data.tripId
        && isNonEmptyString(request.resource.data.title)
        && existsAfter(/databases/$(database)/documents/apps/waypoint/trips/$(resource.data.tripId))
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(resource.data.tripId)).data.title == request.resource.data.title
        && request.auth.uid in getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(resource.data.tripId)).data.members
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(resource.data.tripId)).data.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      allow delete: if false;
    }

    match /apps/waypoint/trips/{tripId} {
      function isTripMember() {
        return request.auth != null
          && request.auth.uid in resource.data.members;
      }

      function isTripAdmin() {
        return isTripMember()
          && resource.data.members[request.auth.uid].role == 'ADMIN';
      }

      function isTripCityValid(city) {
        return city == null || (
          city is map
          && city.keys().hasOnly(['name', 'region', 'country', 'latitude', 'longitude'])
          && isNonEmptyString(city.name)
          && city.name.size() <= 120
          && (city.region == null || (city.region is string && city.region.size() <= 120))
          && (city.country == null || (city.country is string && city.country.size() <= 120))
          && city.latitude is number
          && city.latitude >= -90
          && city.latitude <= 90
          && city.longitude is number
          && city.longitude >= -180
          && city.longitude <= 180
        );
      }

      function isTripFieldSetValid(data) {
        return data.keys().hasOnly([
            'id',
            'title',
            'coverImageUrl',
            'startDate',
            'endDate',
            'defaultCurrency',
            'isArchived',
            'members',
            'inviteCode',
            'sharedAlbumUrl',
            'sharedAlbumSetByUid',
            'sharedAlbumSetAt',
            'timeModel',
            'timezone',
            'city',
            'dateShiftStatus',
            'createdBy',
            'createdAt',
            'lastEditedAt'
          ])
          && data.id == tripId
          && isNonEmptyString(data.title)
          && (data.coverImageUrl == null || data.coverImageUrl is string)
          && isTimestampNumber(data.startDate)
          && isTimestampNumber(data.endDate)
          && data.endDate >= data.startDate
          && (data.defaultCurrency == null || data.defaultCurrency is string)
          && (!('isArchived' in data) || data.isArchived is bool)
          && data.members is map
          && (data.inviteCode == null || data.inviteCode is string)
          && (!('sharedAlbumUrl' in data)
            || data.sharedAlbumUrl == null
            || data.sharedAlbumUrl is string)
          && (!('sharedAlbumSetByUid' in data)
            || data.sharedAlbumSetByUid == null
            || data.sharedAlbumSetByUid is string)
          && (!('sharedAlbumSetAt' in data)
            || data.sharedAlbumSetAt == null
            || isTimestampNumber(data.sharedAlbumSetAt))
          && (!('timeModel' in data) || data.timeModel in ['RELATIVE', 'ABSOLUTE'])
          && (!('timezone' in data) || data.timezone == null || isNonEmptyString(data.timezone))
          && isTripCityValid(data.get('city', null))
          && (!('dateShiftStatus' in data)
            || data.dateShiftStatus == null
            || data.dateShiftStatus in ['IDLE', 'PENDING'])
          && data.createdBy is string
          && isTimestampNumber(data.createdAt)
          && isTimestampNumber(data.lastEditedAt);
      }

      function isTripMemberEntryValid(member, uid) {
        return member is map
          && member.keys().hasOnly(['uid', 'role', 'joinedAt'])
          && member.uid == uid
          && member.role in ['ADMIN', 'EDITOR', 'COMMENTER', 'VIEWER']
          && isTimestampNumber(member.joinedAt);
      }

      function isTripCreateValid() {
        return request.auth != null
          && isTripFieldSetValid(request.resource.data)
          && request.resource.data.get('timeModel', null) == 'RELATIVE'
          && isNonEmptyString(request.resource.data.get('timezone', null))
          && request.resource.data.isArchived == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.members.keys().hasOnly([request.auth.uid])
          && isTripMemberEntryValid(
            request.resource.data.members[request.auth.uid],
            request.auth.uid
          )
          && request.resource.data.members[request.auth.uid].role == 'ADMIN';
      }

      function isTimeModelUnchanged() {
        return request.resource.data.get('timeModel', null) == resource.data.get('timeModel', null);
      }

      function isTripUpdateValid() {
        return isTripFieldSetValid(request.resource.data)
          && isTimeModelUnchanged()
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members;
      }

      function isTripEditorOrAdmin() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && resource.data.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      function isTripArchiveUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isArchived',
            'lastEditedAt'
          ])
          && request.resource.data.isArchived is bool
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isTripGeneralUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'coverImageUrl',
            'startDate',
            'endDate',
            'timezone',
            'city',
            'defaultCurrency',
            'lastEditedAt'
          ])
          && isTripUpdateValid()
          && (
            isRelativeTrip(resource.data)
            || (
              request.resource.data.startDate == resource.data.startDate
              && request.resource.data.endDate == resource.data.endDate
              && request.resource.data.get('timezone', null) == resource.data.get('timezone', null)
            )
          );
      }

      function isTripAlbumUpdate() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let isFirstSet = !('sharedAlbumUrl' in resource.data)
          || resource.data.sharedAlbumUrl == null;
        return affectedKeys.hasOnly([
            'sharedAlbumUrl',
            'sharedAlbumSetByUid',
            'sharedAlbumSetAt',
            'lastEditedAt'
          ])
          && (
            (
              request.resource.data.sharedAlbumUrl == null
              && request.resource.data.sharedAlbumSetByUid == null
              && request.resource.data.sharedAlbumSetAt == null
            )
            || (
              request.resource.data.sharedAlbumUrl is string
              && request.resource.data.sharedAlbumSetByUid == request.auth.uid
              && isTimestampNumber(request.resource.data.sharedAlbumSetAt)
            )
          )
          && isTripUpdateValid()
          && (isFirstSet || isTripEditorOrAdmin());
      }

      function isTripMembershipApprovalValid() {
        let addedUids = request.resource.data.members.keys().removeAll(resource.data.members.keys());
        return isTripAdmin()
          && isTripFieldSetValid(request.resource.data)
          && isTimeModelUnchanged()
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members.keys().hasAll(resource.data.members.keys())
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && addedUids.size() == 1
          && isTripMemberEntryValid(
            request.resource.data.members[addedUids[0]],
            addedUids[0]
          )
          && exists(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId))
          && get(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId)).data.uid == addedUids[0]
          && get(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId)).data.tripId == tripId
          && !existsAfter(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId));
      }

      function isTripMembershipManagementValid() {
        return isTripAdmin()
          && isTripFieldSetValid(request.resource.data)
          && isTimeModelUnchanged()
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members.keys().hasAll([request.auth.uid, resource.data.createdBy])
          && request.resource.data.members[request.auth.uid]
            == resource.data.members[request.auth.uid]
          && request.resource.data.members[resource.data.createdBy]
            == resource.data.members[resource.data.createdBy]
          && (
            request.resource.data.members.keys().hasAll(resource.data.members.keys())
              && resource.data.members.keys().hasAll(request.resource.data.members.keys())
            || request.resource.data.members.size()
              == resource.data.members.size() - 1
          );
      }

      // Someone an Admin invited by email joins themselves, without a request: only as the role the
      // invitation names, only as themselves, and only by using up that invitation in the same commit.
      // They can't read the trip yet, so every check here is against the write and the invitation. Only
      // `members` and `lastEditedAt` may change, so the rest of the document keeps the shape it already had.
      function isTripEmailInviteJoinValid() {
        let uid = request.auth.uid;
        let email = request.auth.token.get('email', '').lower();
        let invitePath = /databases/$(database)/documents/apps/waypoint/emailInvites/$(tripId + '_' + email);
        let addedUids = request.resource.data.members.keys().removeAll(resource.data.members.keys());
        return request.auth.token.get('email_verified', false) == true
          && email != ''
          && !(uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastEditedAt'])
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && request.resource.data.members.keys().hasAll(resource.data.members.keys())
          && addedUids.size() == 1
          && addedUids[0] == uid
          && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([uid])
          && isTripMemberEntryValid(request.resource.data.members[uid], uid)
          && exists(invitePath)
          && get(invitePath).data.tripId == tripId
          && get(invitePath).data.invitedBy in resource.data.members
          && resource.data.members[get(invitePath).data.invitedBy].role == 'ADMIN'
          && get(invitePath).data.role == request.resource.data.members[uid].role
          && !existsAfter(invitePath);
      }

      allow read: if isTripMember();
      allow create: if isTripCreateValid();
      allow update: if (isTripMember() && (
        (isTripEditorOrAdmin() && isTripGeneralUpdate())
         || (isTripMember() && isTripAlbumUpdate())
        || (isTripAdmin() && isTripArchiveUpdate())
        || isTripMembershipApprovalValid()
        || isTripMembershipManagementValid()
      ))
        || (request.auth != null && !(request.auth.uid in resource.data.members) && isTripEmailInviteJoinValid());
      allow delete: if isTripAdmin();

      match /checklist/{checklistId} {
        function tripExists() {
          return exists(/databases/$(database)/documents/apps/waypoint/trips/$(tripId));
        }

        function isChecklistMember() {
          return request.auth != null
            && tripExists()
            && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
        }

        function hasChecklistRole(role) {
          return isChecklistMember()
            && get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members[request.auth.uid].role == role;
        }

        function isChecklistEditor() {
          return hasChecklistRole('ADMIN') || hasChecklistRole('EDITOR');
        }

        function isChecklistAdminOnlyWhileActive() {
          let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
          return request.auth != null && request.auth.uid in trip.members && (
            isTripActive(trip)
              ? trip.members[request.auth.uid].role == 'ADMIN'
              : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
          );
        }

        function isChecklistShapeValid(data) {
          return data.keys().hasOnly([
              'id',
              'tripId',
              'title',
              'category',
              'customCategoryLabel',
              'note',
              'completeByDayIndex',
              'assignedToUids',
              'isCompleted',
              'markedCompletedByUid',
              'markedCompletedAt',
              'createdBy',
              'createdAt',
              'lastEditedAt'
            ])
            && data.id == checklistId
            && data.tripId == tripId
            && isNonEmptyString(data.title)
            && data.category in ['DOCUMENTS', 'PACKING', 'BOOKINGS', 'LOGISTICS', 'OTHER']
            && (data.customCategoryLabel == null || isNonEmptyString(data.customCategoryLabel))
            && (data.category != 'OTHER' || isNonEmptyString(data.customCategoryLabel))
            && (data.note == null || data.note is string)
            && (data.completeByDayIndex == null || data.completeByDayIndex is int)
            && data.assignedToUids is list
            && data.isCompleted is bool
            && (data.markedCompletedByUid == null || data.markedCompletedByUid is string)
            && (data.markedCompletedAt == null || isTimestampNumber(data.markedCompletedAt))
            && data.createdBy is string
            && isTimestampNumber(data.createdAt)
            && isTimestampNumber(data.lastEditedAt);
        }

        function isChecklistImmutableFieldsValid() {
          return request.resource.data.id == resource.data.id
            && request.resource.data.tripId == resource.data.tripId
            && request.resource.data.tripId == tripId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        function isChecklistAssignedToggleValid() {
          return isChecklistMember()
            && request.auth.uid in resource.data.assignedToUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isCompleted',
              'markedCompletedByUid',
              'markedCompletedAt',
              'lastEditedAt'
            ])
            && request.resource.data.isCompleted is bool
            && (
              request.resource.data.isCompleted == false
                ? request.resource.data.markedCompletedByUid == null
                  && request.resource.data.markedCompletedAt == null
                : request.resource.data.markedCompletedByUid == request.auth.uid
                  && isTimestampNumber(request.resource.data.markedCompletedAt)
            )
            && isTimestampNumber(request.resource.data.lastEditedAt);
        }

        allow read: if isChecklistMember();
        allow create: if isChecklistEditor()
          && isChecklistShapeValid(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if (
          isChecklistAdminOnlyWhileActive()
          && isChecklistShapeValid(request.resource.data)
          && isChecklistImmutableFieldsValid()
        ) || isChecklistAssignedToggleValid();
        allow delete: if isChecklistAdminOnlyWhileActive();
      }
    }

    match /apps/waypoint/trips/{tripId}/events/{eventId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripSubcollectionEditor() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember()
          && trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      // Creating a brand-new event stays open to Editors before the trip starts, but
      // narrows to Admin-only once it has — same rationale as editing an existing one.
      function isTripCreateAllowed() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember()
          && (
            hasTripStarted(trip)
              ? trip.members[request.auth.uid].role == 'ADMIN'
              : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
          );
      }

      function isTripAdminOnlyWhileActive() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return request.auth != null && request.auth.uid in trip.members && (
          isTripActive(trip)
            ? trip.members[request.auth.uid].role == 'ADMIN'
            : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
        );
      }

      // Legacy (absolute) trips: a real timestamp plus the day it falls on.
      function isAbsoluteEventTimeValid(data) {
        return data.dayIndex is int
          && data.endDayIndex is int
          && data.endDayIndex >= data.dayIndex
          && isTimestampNumber(data.startAt)
          && (data.endAt == null || isTimestampNumber(data.endAt))
          && data.get('startTime', null) == null
          && data.get('endTime', null) == null
          && data.get('timezone', null) == null
          && data.get('endTimezone', null) == null;
      }

      // Relative trips: a trip day (or none) plus a floating "HH:mm", never a timestamp.
      // An end in its own time zone (a flight landing elsewhere) can read earlier on the clock than
      // its start, so the clock-time ordering only applies when both share a zone.
      function isRelativeEventTimeValid(data) {
        return (
            (data.dayIndex == null && data.endDayIndex == null)
            || (data.dayIndex is int && data.endDayIndex is int && data.endDayIndex >= data.dayIndex)
          )
          && data.get('startAt', null) == null
          && data.get('endAt', null) == null
          && isClockTime(data.get('startTime', null))
          && (data.get('endTime', null) == null
            || (
              isClockTime(data.endTime)
              && data.dayIndex != null
              && (data.endDayIndex > data.dayIndex
                || data.endTime > data.startTime
                || data.get('endTimezone', null) != null)
            ))
          && (data.get('timezone', null) == null || isNonEmptyString(data.timezone))
          && (data.get('endTimezone', null) == null || isNonEmptyString(data.endTimezone));
      }

      function isEventTimeValid(data) {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isRelativeTrip(trip) ? isRelativeEventTimeValid(data) : isAbsoluteEventTimeValid(data);
      }

      function isEventShapeValid() {
        return request.resource.data.keys().hasOnly([
            'id',
            'tripId',
            'eventType',
            'dayIndex',
            'endDayIndex',
            'title',
            'startAt',
            'endAt',
            'startTime',
            'endTime',
            'timezone',
            'endTimezone',
            'locationName',
            'address',
            'latitude',
            'longitude',
            'eventDetails',
            'notes',
            'attendeeTargetType',
            'assignedMemberIds',
            'venueOpenTime',
            'venueCloseTime',
            'changeHistory',
            'place',
            'linkUrl',
            'linkPreview',
            'linkKind',
            'groupLabel',
            'stackLabel',
            'reminderMinutesBefore',
            'reminderEnabled',
            'reminderId',
            'isArchived',
            'archivedBy',
            'archivedAt',
            'seenBy',
            'createdBy',
            'createdAt',
            'lastEditedAt'
          ])
          && request.resource.data.id == eventId
          && request.resource.data.tripId == tripId
          && request.resource.data.eventType in ['TRAVEL', 'DINING', 'ACTIVITY', 'FREE_TIME']
          && isEventTimeValid(request.resource.data)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && (request.resource.data.locationName == null || request.resource.data.locationName is string)
          && (request.resource.data.address == null || request.resource.data.address is string)
          && (request.resource.data.latitude == null || request.resource.data.latitude is number)
          && (request.resource.data.longitude == null || request.resource.data.longitude is number)
          && (request.resource.data.eventDetails == null || request.resource.data.eventDetails is map)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && request.resource.data.attendeeTargetType in [
            'EVERYONE_CURRENT', 'EVERYONE_INCLUDING_FUTURE', 'SPECIFIC_MEMBERS'
          ]
          && request.resource.data.assignedMemberIds is list
          && (request.resource.data.venueOpenTime == null || isNonEmptyString(request.resource.data.venueOpenTime))
          && (request.resource.data.venueCloseTime == null || isNonEmptyString(request.resource.data.venueCloseTime))
          && (request.resource.data.place == null || (
            request.resource.data.place is map
            && request.resource.data.place.placeId is string
          ))
          && (request.resource.data.linkUrl == null || (
            request.resource.data.linkUrl is string
            && request.resource.data.linkUrl.size() <= 2048
            && request.resource.data.linkUrl.matches('^https?://.*')
          ))
          && (request.resource.data.linkPreview == null || request.resource.data.linkPreview is map)
          && request.resource.data.get('linkKind', null) in [null, 'WEBSITE', 'RESERVATION', 'MENU', 'BOOKING']
          && (request.resource.data.get('groupLabel', null) == null || isNonEmptyString(request.resource.data.get('groupLabel', null)))
          && (request.resource.data.get('stackLabel', null) == null || isNonEmptyString(request.resource.data.get('stackLabel', null)))
          && request.resource.data.reminderMinutesBefore is int
          && request.resource.data.reminderMinutesBefore >= 5
          && request.resource.data.reminderMinutesBefore <= 180
          && request.resource.data.reminderMinutesBefore % 5 == 0
          && request.resource.data.reminderEnabled is bool
          && (request.resource.data.reminderId == null || request.resource.data.reminderId is string)
          && request.resource.data.isArchived is bool
          && (request.resource.data.archivedBy == null || request.resource.data.archivedBy is string)
          && (request.resource.data.archivedAt == null || isTimestampNumber(request.resource.data.archivedAt))
          && request.resource.data.seenBy is map
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isEventImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function isTripAdminMember() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember() && trip.members[request.auth.uid].role == 'ADMIN';
      }

      function isEventArchiveStateUnchanged() {
        return request.resource.data.isArchived == resource.data.get('isArchived', false)
          && request.resource.data.archivedBy == resource.data.get('archivedBy', null)
          && request.resource.data.archivedAt == resource.data.get('archivedAt', null);
      }

      // Archiving or restoring an event is Admin-only, whatever the trip's phase.
      function isEventArchiveChangeAllowed() {
        return isEventArchiveStateUnchanged() || isTripAdminMember();
      }

      // Every trip member (not just editors/admins) can mark an event "seen" for
      // themselves — but only their own key, never anyone else's.
      function isEventSeenByUpdateValid() {
        return isTripSubcollectionMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
          && request.resource.data.seenBy is map
          && request.resource.data.seenBy.diff(resource.data.get('seenBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && isTimestampNumber(request.resource.data.seenBy[request.auth.uid]);
      }

      allow read: if isTripSubcollectionMember();
      allow create: if isTripCreateAllowed()
        && isEventShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if (
        isTripAdminOnlyWhileActive()
        && isEventShapeValid()
        && isEventImmutableFieldsValid()
        && isEventArchiveChangeAllowed()
      ) || isEventSeenByUpdateValid();
      allow delete: if isTripAdminOnlyWhileActive();
    }

    match /apps/waypoint/trips/{tripId}/eventSuggestions/{suggestionId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripAdminMember() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember() && trip.members[request.auth.uid].role == 'ADMIN';
      }

      function isAbsoluteSuggestedTimeValid(data) {
        return isTimestampNumber(data.suggestedStartAt)
          && (data.suggestedEndAt == null || (
            isTimestampNumber(data.suggestedEndAt)
            && data.suggestedEndAt > data.suggestedStartAt
          ))
          && data.get('suggestedDayIndex', null) == null
          && data.get('suggestedStartTime', null) == null
          && data.get('suggestedEndTime', null) == null;
      }

      function isRelativeSuggestedTimeValid(data) {
        return data.get('suggestedStartAt', null) == null
          && data.get('suggestedEndAt', null) == null
          && data.get('suggestedDayIndex', null) is int
          && isClockTime(data.get('suggestedStartTime', null))
          && (data.get('suggestedEndTime', null) == null
            || (isClockTime(data.suggestedEndTime) && data.suggestedEndTime > data.suggestedStartTime));
      }

      function isSuggestedTimeValid(data) {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isRelativeTrip(trip)
          ? isRelativeSuggestedTimeValid(data)
          : isAbsoluteSuggestedTimeValid(data);
      }

      function isSuggestionShapeValid() {
        return request.resource.data.keys().hasOnly([
            'id',
            'tripId',
            'eventId',
            'suggestedTitle',
            'suggestedStartAt',
            'suggestedEndAt',
            'suggestedDayIndex',
            'suggestedStartTime',
            'suggestedEndTime',
            'suggestedLocationName',
            'suggestedAddress',
            'suggestedLatitude',
            'suggestedLongitude',
            'suggestedPlace',
            'note',
            'upvotedBy',
            'createdBy',
            'createdAt'
          ])
          && request.resource.data.id == suggestionId
          && request.resource.data.tripId == tripId
          && isNonEmptyString(request.resource.data.eventId)
          && isNonEmptyString(request.resource.data.suggestedTitle)
          && isSuggestedTimeValid(request.resource.data)
          && (request.resource.data.suggestedLocationName == null || request.resource.data.suggestedLocationName is string)
          && (request.resource.data.suggestedAddress == null || request.resource.data.suggestedAddress is string)
          && (request.resource.data.suggestedLatitude == null || request.resource.data.suggestedLatitude is number)
          && (request.resource.data.suggestedLongitude == null || request.resource.data.suggestedLongitude is number)
          && (request.resource.data.suggestedPlace == null || request.resource.data.suggestedPlace is map)
          && (request.resource.data.note == null || request.resource.data.note is string)
          && request.resource.data.upvotedBy is list
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      // Any trip member can upvote/un-upvote — but only their own uid, never anyone else's.
      function isSuggestionUpvoteUpdateValid() {
        let added = request.resource.data.upvotedBy.removeAll(resource.data.upvotedBy);
        let removed = resource.data.upvotedBy.removeAll(request.resource.data.upvotedBy);
        return isTripSubcollectionMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotedBy'])
          && request.resource.data.upvotedBy is list
          && added.removeAll([request.auth.uid]).size() == 0
          && removed.removeAll([request.auth.uid]).size() == 0
          && (added.size() + removed.size()) <= 1;
      }

      // The suggester can edit their own suggestion's content — everything except who made
      // it, when, and who's upvoted it, which stay untouched across an edit.
      function isSuggestionOwnerUpdateValid() {
        return isTripSubcollectionMember()
          && resource.data.createdBy == request.auth.uid
          && isSuggestionShapeValid()
          && request.resource.data.id == resource.data.id
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.eventId == resource.data.eventId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.upvotedBy == resource.data.upvotedBy;
      }

      allow read: if isTripSubcollectionMember();
      allow create: if isTripSubcollectionMember()
        && isSuggestionShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSuggestionUpvoteUpdateValid() || isSuggestionOwnerUpdateValid();
      allow delete: if isTripAdminMember();
    }

    match /apps/waypoint/trips/{tripId}/announcements/{announcementId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripAdminMember() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember() && trip.members[request.auth.uid].role == 'ADMIN';
      }

      function isAnnouncementShapeValid() {
        return request.resource.data.keys().hasOnly([
            'id',
            'tripId',
            'severity',
            'title',
            'body',
            'expiresAt',
            'dismissedBy',
            'createdBy',
            'createdAt'
          ])
          && request.resource.data.id == announcementId
          && request.resource.data.tripId == tripId
          && request.resource.data.severity in ['INFO', 'HEADS_UP', 'URGENT']
          && isNonEmptyString(request.resource.data.title)
          && isNonEmptyString(request.resource.data.body)
          && (request.resource.data.expiresAt == null || isTimestampNumber(request.resource.data.expiresAt))
          && request.resource.data.dismissedBy is map
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt);
      }

      // Any trip member except the announcement's own author can dismiss it — and only
      // their own key, never anyone else's.
      function isAnnouncementDismissUpdateValid() {
        return isTripSubcollectionMember()
          && resource.data.createdBy != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissedBy'])
          && request.resource.data.dismissedBy is map
          && request.resource.data.dismissedBy.diff(resource.data.dismissedBy).affectedKeys().hasOnly([request.auth.uid])
          && isTimestampNumber(request.resource.data.dismissedBy[request.auth.uid]);
      }

      allow read: if isTripSubcollectionMember();
      allow create: if isTripAdminMember()
        && isAnnouncementShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAnnouncementDismissUpdateValid();
      allow delete: if isTripAdminMember();
    }

    match /apps/waypoint/trips/{tripId}/ideas/{ideaId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripNotStarted() {
        return !hasTripStarted(get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data);
      }

      // Rules can't check each list element's type, so the lists are bounded and the enum ones
      // are limited to their allowed values; the app also ignores anything unexpected on read.
      function isIdeaDetailsValid(ideaType, details) {
        return details == null
          || (details is map
            && details.keys().hasAll(['suggestedDays', 'suggestedTimeBlocks'])
            && details.suggestedDays is list
            && details.suggestedDays.size() <= 90
            && details.suggestedTimeBlocks is list
            && details.suggestedTimeBlocks.hasOnly(['MORNING', 'AFTERNOON', 'EVENING'])
            && (ideaType == 'RESTAURANT'
              ? details.keys().hasOnly(['cuisines', 'suggestedDays', 'suggestedTimeBlocks'])
                && details.keys().hasAll(['cuisines'])
                && details.cuisines is list
                && details.cuisines.size() <= 20
              : details.keys().hasOnly(['settings', 'suggestedDays', 'suggestedTimeBlocks'])
                && details.keys().hasAll(['settings'])
                && details.settings is list
                && details.settings.hasOnly(['INDOOR', 'OUTDOOR'])));
      }

      function isIdeaShapeValid() {
        return request.resource.data.keys().hasOnly([
            'id',
            'tripId',
            'ideaType',
            'title',
            'notes',
            'linkUrl',
            'ideaDetails',
            'addedByUid',
            'voterUids',
            'convertedToEntityId',
            'createdAt',
            'lastEditedAt'
          ])
          && request.resource.data.id == ideaId
          && request.resource.data.tripId == tripId
          && request.resource.data.ideaType in ['RESTAURANT', 'ACTIVITY']
          && isNonEmptyString(request.resource.data.title)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && (request.resource.data.linkUrl == null || isHttpUrl(request.resource.data.linkUrl))
          && isIdeaDetailsValid(request.resource.data.ideaType, request.resource.data.ideaDetails)
          && request.resource.data.addedByUid is string
          && request.resource.data.voterUids is list
          && (request.resource.data.convertedToEntityId == null || request.resource.data.convertedToEntityId is string)
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      // Anyone on the trip can post an idea until the trip starts — never on another member's
      // behalf, and never with more than their own single vote.
      function isIdeaCreateValid() {
        return isTripSubcollectionMember()
          && isTripNotStarted()
          && isIdeaShapeValid()
          && request.resource.data.addedByUid == request.auth.uid
          && request.resource.data.convertedToEntityId == null
          && (request.resource.data.voterUids.size() == 0 || request.resource.data.voterUids == [request.auth.uid]);
      }

      // Voting never closes: a member can only add or remove their own uid.
      function isIdeaVoteUpdateValid() {
        let added = request.resource.data.voterUids.removeAll(resource.data.voterUids);
        let removed = resource.data.voterUids.removeAll(request.resource.data.voterUids);
        return isTripSubcollectionMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voterUids'])
          && request.resource.data.voterUids is list
          && request.resource.data.voterUids.toSet().size() == request.resource.data.voterUids.size()
          && added.removeAll([request.auth.uid]).size() == 0
          && removed.removeAll([request.auth.uid]).size() == 0
          && (added.size() + removed.size()) <= 1;
      }

      // Only the poster can edit an idea, in any trip phase; votes and who posted it are never
      // touched by an edit.
      function isIdeaPoster() {
        return isTripSubcollectionMember()
          && resource.data.addedByUid == request.auth.uid;
      }

      // An Admin can also remove someone else's idea.
      function isIdeaDeleteAllowed() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isIdeaPoster()
          || (isTripSubcollectionMember() && trip.members[request.auth.uid].role == 'ADMIN');
      }

      function isIdeaEditValid() {
        return isIdeaPoster()
          && isIdeaShapeValid()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ideaType', 'title', 'notes', 'linkUrl', 'ideaDetails', 'lastEditedAt']);
      }

      // Adding an idea to the itinerary is the same permission as creating an event, and only
      // ever lands together with that event in one commit.
      function isIdeaConversionValid() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember()
          && (
            hasTripStarted(trip)
              ? trip.members[request.auth.uid].role == 'ADMIN'
              : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
          )
          && resource.data.get('convertedToEntityId', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['convertedToEntityId'])
          && request.resource.data.convertedToEntityId is string
          && !exists(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)/events/$(request.resource.data.convertedToEntityId))
          && existsAfter(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)/events/$(request.resource.data.convertedToEntityId))
          && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)/events/$(request.resource.data.convertedToEntityId)).data.createdBy == request.auth.uid;
      }

      allow read: if isTripSubcollectionMember();
      allow create: if isIdeaCreateValid();
      allow update: if isIdeaVoteUpdateValid() || isIdeaEditValid() || isIdeaConversionValid();
      allow delete: if isIdeaDeleteAllowed();
    }

    match /apps/waypoint/trips/{tripId}/stays/{stayId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripSubcollectionEditor() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember()
          && trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      // Creating a brand-new stay stays open to Editors before the trip starts, but
      // narrows to Admin-only once it has — same rationale as editing an existing one.
      function isTripCreateAllowed() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember()
          && (
            hasTripStarted(trip)
              ? trip.members[request.auth.uid].role == 'ADMIN'
              : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
          );
      }

      function isTripAdminOnlyWhileActive() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return request.auth != null && request.auth.uid in trip.members && (
          isTripActive(trip)
            ? trip.members[request.auth.uid].role == 'ADMIN'
            : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
        );
      }

      // A trip day offset plus "HH:mm" for a stay's check-in, check-out and planned pair.
      function isStayDayTimeValid(data, dayField, timeField) {
        return data.get(dayField, null) is int && isClockTime(data.get(timeField, null));
      }

      // Whether day B + time B falls strictly after day A + time A ("HH:mm" strings sort correctly).
      function dayTimeAfter(dayA, timeA, dayB, timeB) {
        return dayB > dayA || (dayB == dayA && timeB > timeA);
      }

      function isAbsoluteStayTimeValid(data) {
        return isTimestampNumber(data.checkInAt)
          && isTimestampNumber(data.checkOutAt)
          && data.checkOutAt > data.checkInAt
          && isTimestampNumber(data.plannedArrivalAt)
          && isTimestampNumber(data.plannedDepartureAt)
          && data.plannedDepartureAt > data.plannedArrivalAt
          && data.get('checkInDayIndex', null) == null
          && data.get('checkInTime', null) == null
          && data.get('checkOutDayIndex', null) == null
          && data.get('checkOutTime', null) == null
          && data.get('plannedArrivalDayIndex', null) == null
          && data.get('plannedArrivalTime', null) == null
          && data.get('plannedDepartureDayIndex', null) == null
          && data.get('plannedDepartureTime', null) == null;
      }

      function isRelativeStayTimeValid(data) {
        return data.get('checkInAt', null) == null
          && data.get('checkOutAt', null) == null
          && data.get('plannedArrivalAt', null) == null
          && data.get('plannedDepartureAt', null) == null
          && isStayDayTimeValid(data, 'checkInDayIndex', 'checkInTime')
          && isStayDayTimeValid(data, 'checkOutDayIndex', 'checkOutTime')
          && isStayDayTimeValid(data, 'plannedArrivalDayIndex', 'plannedArrivalTime')
          && isStayDayTimeValid(data, 'plannedDepartureDayIndex', 'plannedDepartureTime')
          && dayTimeAfter(
            data.checkInDayIndex, data.checkInTime, data.checkOutDayIndex, data.checkOutTime
          )
          && dayTimeAfter(
            data.plannedArrivalDayIndex, data.plannedArrivalTime,
            data.plannedDepartureDayIndex, data.plannedDepartureTime
          );
      }

      function isStayTimeValid(data) {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isRelativeTrip(trip) ? isRelativeStayTimeValid(data) : isAbsoluteStayTimeValid(data);
      }

      function isStayShapeValid() {
        return request.resource.data.keys().hasOnly([
            'id',
            'tripId',
            'name',
            'stayType',
            'address',
            'latitude',
            'longitude',
            'checkInAt',
            'checkOutAt',
            'checkInTimezone',
            'plannedArrivalAt',
            'plannedDepartureAt',
            'checkInDayIndex',
            'checkInTime',
            'checkOutDayIndex',
            'checkOutTime',
            'plannedArrivalDayIndex',
            'plannedArrivalTime',
            'plannedDepartureDayIndex',
            'plannedDepartureTime',
            'confirmationCode',
            'notes',
            'place',
            'linkUrl',
            'linkPreview',
            'changeHistory',
            'seenBy',
            'createdBy',
            'createdAt',
            'lastEditedAt'
          ])
          && request.resource.data.id == stayId
          && request.resource.data.tripId == tripId
          && isNonEmptyString(request.resource.data.name)
          && request.resource.data.stayType in ['HOTEL', 'RENTAL', 'FRIEND_FAMILY', 'OTHER']
          && isNonEmptyString(request.resource.data.address)
          && (request.resource.data.latitude == null || request.resource.data.latitude is number)
          && (request.resource.data.longitude == null || request.resource.data.longitude is number)
          && isStayTimeValid(request.resource.data)
          && (request.resource.data.checkInTimezone == null
            || isNonEmptyString(request.resource.data.checkInTimezone))
          && (request.resource.data.confirmationCode == null
            || isNonEmptyString(request.resource.data.confirmationCode))
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && (request.resource.data.place == null || (
            request.resource.data.place is map
            && request.resource.data.place.placeId is string
          ))
          && (request.resource.data.linkUrl == null || (
            request.resource.data.linkUrl is string
            && request.resource.data.linkUrl.size() <= 2048
            && request.resource.data.linkUrl.matches('^https?://.*')
          ))
          && (request.resource.data.linkPreview == null || request.resource.data.linkPreview is map)
          && request.resource.data.changeHistory is list
          && request.resource.data.seenBy is map
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      // Every trip member (not just editors/admins) can mark a stay "seen" for
      // themselves — but only their own key, never anyone else's.
      function isStaySeenByUpdateValid() {
        return isTripSubcollectionMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenBy'])
          && request.resource.data.seenBy is map
          && request.resource.data.seenBy.diff(resource.data.get('seenBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && isTimestampNumber(request.resource.data.seenBy[request.auth.uid]);
      }

      allow read: if isTripSubcollectionMember();
      allow create: if isTripCreateAllowed()
        && isStayShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      // `seenBy` is only ever a member's own key, so an edit may touch it solely to give a
      // stay saved before the field existed its empty starting map.
      function isStayEditKeySetValid() {
        let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
        return affectedKeys.hasOnly([
            'name',
            'stayType',
            'address',
            'latitude',
            'longitude',
            'checkInAt',
            'checkOutAt',
            'checkInTimezone',
            'plannedArrivalAt',
            'plannedDepartureAt',
            'checkInDayIndex',
            'checkInTime',
            'checkOutDayIndex',
            'checkOutTime',
            'plannedArrivalDayIndex',
            'plannedArrivalTime',
            'plannedDepartureDayIndex',
            'plannedDepartureTime',
            'confirmationCode',
            'notes',
            'place',
            'linkUrl',
            'linkPreview',
            'changeHistory',
            'seenBy',
            'lastEditedAt'
          ])
          && (!affectedKeys.hasAny(['seenBy'])
            || (!('seenBy' in resource.data) && request.resource.data.seenBy.size() == 0));
      }

      allow update: if (
        isTripAdminOnlyWhileActive()
        && isStayEditKeySetValid()
        && isStayShapeValid()
      ) || isStaySeenByUpdateValid();
      allow delete: if isTripAdminOnlyWhileActive();
    }

    match /apps/waypoint/trips/{tripId}/rentals/{rentalId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      // Creating a brand-new rental stays open to Editors before the trip starts, but
      // narrows to Admin-only once it has — same rule as stays.
      function isTripCreateAllowed() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripSubcollectionMember()
          && (
            hasTripStarted(trip)
              ? trip.members[request.auth.uid].role == 'ADMIN'
              : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
          );
      }

      function isTripAdminOnlyWhileActive() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return request.auth != null && request.auth.uid in trip.members && (
          isTripActive(trip)
            ? trip.members[request.auth.uid].role == 'ADMIN'
            : trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR']
        );
      }

      // Pickup and return are always a trip day offset + "HH:mm", whatever the trip's time model.
      function isRentalTimeValid(data) {
        return data.pickupDayIndex is int
          && data.returnDayIndex is int
          && isClockTime(data.pickupTime)
          && isClockTime(data.returnTime)
          && (data.returnDayIndex > data.pickupDayIndex
            || (data.returnDayIndex == data.pickupDayIndex && data.returnTime > data.pickupTime));
      }

      function isNullableNumber(value) {
        return value == null || value is number;
      }

      function isNullablePlace(value) {
        return value == null || (value is map && value.placeId is string);
      }

      function isRentalShapeValid() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'id',
            'tripId',
            'rentalType',
            'name',
            'vehicle',
            'pickupAddress',
            'pickupLatitude',
            'pickupLongitude',
            'pickupPlace',
            'returnAddress',
            'returnLatitude',
            'returnLongitude',
            'returnPlace',
            'pickupDayIndex',
            'pickupTime',
            'returnDayIndex',
            'returnTime',
            'timezone',
            'confirmationCode',
            'notes',
            'linkUrl',
            'linkPreview',
            'createdBy',
            'createdAt',
            'lastEditedAt'
          ])
          && data.id == rentalId
          && data.tripId == tripId
          && data.rentalType in ['CAR']
          && isNonEmptyString(data.name)
          && (data.vehicle == null || isNonEmptyString(data.vehicle))
          && isNonEmptyString(data.pickupAddress)
          && isNullableNumber(data.pickupLatitude)
          && isNullableNumber(data.pickupLongitude)
          && isNullablePlace(data.pickupPlace)
          && (data.returnAddress == null || isNonEmptyString(data.returnAddress))
          && isNullableNumber(data.returnLatitude)
          && isNullableNumber(data.returnLongitude)
          && isNullablePlace(data.returnPlace)
          && isRentalTimeValid(data)
          && (data.timezone == null || isNonEmptyString(data.timezone))
          && (data.confirmationCode == null || isNonEmptyString(data.confirmationCode))
          && (data.notes == null || data.notes is string)
          && (data.linkUrl == null || (
            data.linkUrl is string
            && data.linkUrl.size() <= 2048
            && data.linkUrl.matches('^https?://.*')
          ))
          && (data.linkPreview == null || data.linkPreview is map)
          && data.createdBy is string
          && isTimestampNumber(data.createdAt)
          && isTimestampNumber(data.lastEditedAt);
      }

      function isRentalEditKeySetValid() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'rentalType',
          'name',
          'vehicle',
          'pickupAddress',
          'pickupLatitude',
          'pickupLongitude',
          'pickupPlace',
          'returnAddress',
          'returnLatitude',
          'returnLongitude',
          'returnPlace',
          'pickupDayIndex',
          'pickupTime',
          'returnDayIndex',
          'returnTime',
          'timezone',
          'confirmationCode',
          'notes',
          'linkUrl',
          'linkPreview',
          'lastEditedAt'
        ]);
      }

      allow read: if isTripSubcollectionMember();
      allow create: if isTripCreateAllowed()
        && isRentalShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTripAdminOnlyWhileActive()
        && isRentalEditKeySetValid()
        && isRentalShapeValid();
      allow delete: if isTripAdminOnlyWhileActive();
    }

    match /apps/waypoint/trips/{tripId}/expenses/{expenseId} {
      function isTripExpenseMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripExpenseEditor() {
        let trip = get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
        return isTripExpenseMember()
          && trip.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      // Shape only: a target deleted later leaves a link that reads as none, and must never block editing the expense.
      function isExpenseLinkValid(link) {
        return link == null || (
          link is map
          && link.keys().hasOnly(['kind', 'id'])
          && link.kind in ['EVENT', 'STAY', 'RENTAL']
          && isNonEmptyString(link.id)
          && link.id.size() <= 128
        );
      }

      function isTripExpenseValid(data) {
        return data.keys().hasOnly([
            'id', 'tripId', 'dayIndex', 'title', 'amount', 'amountMin',
            'amountMax', 'paidAmount', 'currency', 'payerUid', 'status', 'category',
            'customCategoryLabel', 'targetType', 'targetMemberIds', 'splitAmounts',
            'paidMemberStatus', 'earlyPayments', 'note', 'groupLabel', 'isPerPerson',
            'linkedTo', 'createdBy', 'createdAt', 'lastEditedAt'
          ])
          && data.id == expenseId
          && data.tripId == tripId
          && (data.dayIndex == null || data.dayIndex is int)
          && isNonEmptyString(data.title)
          && (data.amount == null || data.amount is number)
          && (data.amountMin == null || data.amountMin is number)
          && (data.amountMax == null || data.amountMax is number)
          && ((data.amount != null && data.amountMin == null && data.amountMax == null)
            || (data.amount == null && data.amountMin != null && data.amountMax != null
              && data.amountMax >= data.amountMin))
          && (data.paidAmount == null || (data.paidAmount is number && data.amount == null))
          && isNonEmptyString(data.currency)
          && (data.payerUid == null || (
            data.payerUid is string
            && data.payerUid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members
          ))
          && data.status in ['PAID', 'EXPECTED']
          && data.category in ['FOOD', 'TRANSPORT', 'LODGING', 'ACTIVITIES', 'SHOPPING', 'OTHER']
          && (data.customCategoryLabel == null || isNonEmptyString(data.customCategoryLabel))
          && data.targetType in [
            'EVERYONE_CURRENT', 'EVERYONE_INCLUDING_FUTURE', 'JUST_ME', 'SPECIFIC_MEMBERS'
          ]
          && data.targetMemberIds is list
          && (data.splitAmounts == null || data.splitAmounts is map)
          && data.paidMemberStatus is map
          && data.get('earlyPayments', {}) is map
          && (data.note == null || data.note is string)
          && (data.groupLabel == null || isNonEmptyString(data.groupLabel))
          && data.get('isPerPerson', false) is bool
          && isExpenseLinkValid(data.get('linkedTo', null))
          && data.createdBy is string
          && isTimestampNumber(data.createdAt)
          && isTimestampNumber(data.lastEditedAt);
      }

      function isNewExpenseTargetValid(data) {
        return data.targetType == 'EVERYONE_CURRENT'
          || (data.targetType == 'SPECIFIC_MEMBERS'
            && data.targetMemberIds.size() > 0
            && data.targetMemberIds.hasOnly(get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members.keys()));
      }

      function earlyPaymentsOf(data) {
        return data.get('earlyPayments', {});
      }

      function isEarlyPaymentEntryValid(entry) {
        return entry.keys().hasOnly(['toUid', 'amount', 'paidAt', 'isReturned', 'returnedAt'])
          && entry.toUid is string
          && entry.toUid != request.auth.uid
          && entry.toUid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members
          && entry.amount is number
          && entry.amount > 0
          && entry.amount * 100 == math.floor(entry.amount * 100)
          && isTimestampNumber(entry.paidAt)
          && entry.isReturned is bool
          && (entry.returnedAt == null || isTimestampNumber(entry.returnedAt))
          && entry.isReturned == (entry.returnedAt != null);
      }

      // Everyone-expenses cover whoever is on the trip now; the other targets list their people.
      function isEarlyPaymentPartOfSplit() {
        let targetType = resource.data.targetType;
        return targetType in ['EVERYONE_CURRENT', 'EVERYONE_INCLUDING_FUTURE']
          || (targetType == 'SPECIFIC_MEMBERS' && request.auth.uid in resource.data.targetMemberIds)
          || (targetType == 'JUST_ME' && request.auth.uid == resource.data.payerUid);
      }

      // Nobody sends more than the whole expense (at its highest estimate, times the headcount when per person).
      function isEarlyPaymentAmountBounded(entry) {
        let data = resource.data;
        let top = data.amount != null ? data.amount : data.amountMax;
        let headcount = data.get('isPerPerson', false)
          ? get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members.size()
          : 1;
        return entry.amount <= top * headcount;
      }

      function isEarlyPaymentWriteValid(before, entry) {
        return isEarlyPaymentEntryValid(entry)
          && isEarlyPaymentPartOfSplit()
          && (resource.data.status != 'EXPECTED' || isEarlyPaymentAmountBounded(entry))
          && (resource.data.status == 'EXPECTED'
            || (request.auth.uid in before
              && entry.diff(before[request.auth.uid]).affectedKeys().hasOnly(['isReturned', 'returnedAt'])));
      }

      // A member writes only their own early-payment entry. It can be made, changed or removed while
      // the expense is still expected; once paid, only its returned flag can change (or it be removed).
      function isOwnEarlyPaymentChangeValid() {
        let before = earlyPaymentsOf(resource.data);
        let after = earlyPaymentsOf(request.resource.data);
        return after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in after) || isEarlyPaymentWriteValid(before, after[request.auth.uid]));
      }

      allow read: if isTripExpenseMember();
      allow create: if isTripExpenseEditor()
        && isTripExpenseValid(request.resource.data)
        && isNewExpenseTargetValid(request.resource.data)
        && earlyPaymentsOf(request.resource.data).size() == 0
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTripExpenseEditor()
        && isTripExpenseValid(request.resource.data)
        && request.resource.data.id == resource.data.id
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && earlyPaymentsOf(request.resource.data) == earlyPaymentsOf(resource.data);
      allow update: if isTripExpenseMember()
        && (resource.data.get('paidMemberStatus', {}).keys().hasAll([request.auth.uid])
          || resource.data.targetType == 'EVERYONE_INCLUDING_FUTURE')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidMemberStatus'])
        && request.resource.data.paidMemberStatus.diff(resource.data.get('paidMemberStatus', {}))
          .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.paidMemberStatus[request.auth.uid].isPaid is bool
        && (request.resource.data.paidMemberStatus[request.auth.uid].paidAt == null
          || isTimestampNumber(request.resource.data.paidMemberStatus[request.auth.uid].paidAt));
      allow update: if isTripExpenseMember()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['earlyPayments'])
        && isOwnEarlyPaymentChangeValid();
      // An editor can take an early payment off an expense (a wrong claim, or its author has left),
      // never add or change one.
      allow update: if isTripExpenseEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['earlyPayments'])
        && earlyPaymentsOf(request.resource.data).diff(earlyPaymentsOf(resource.data)).affectedKeys()
          .intersection(earlyPaymentsOf(request.resource.data).keys().toSet()).size() == 0;
      allow delete: if isTripExpenseEditor()
        && earlyPaymentsOf(resource.data).size() == 0;
    }

    // Private to its owner: no one else on the trip can read or change it.
    match /apps/waypoint/personalExpenses/{uid}/items/{expenseId} {
      function isPersonalExpenseValid(data) {
        return data.keys().hasOnly([
            'id', 'tripId', 'dayIndex', 'title', 'amount', 'currency', 'status',
            'category', 'customCategoryLabel', 'note', 'createdAt', 'lastEditedAt'
          ])
          && data.id == expenseId
          && isNonEmptyString(data.tripId)
          && (data.dayIndex == null || data.dayIndex is int)
          && isNonEmptyString(data.title)
          && data.title.size() <= 200
          && data.amount is number
          && data.amount >= 0
          && data.amount <= 1000000000
          && isNonEmptyString(data.currency)
          && data.currency.size() <= 3
          && data.status in ['PAID', 'EXPECTED']
          && data.category in ['FOOD', 'TRANSPORT', 'LODGING', 'ACTIVITIES', 'SHOPPING', 'OTHER']
          && (data.customCategoryLabel == null || (isNonEmptyString(data.customCategoryLabel) && data.customCategoryLabel.size() <= 60))
          && (data.note == null || (data.note is string && data.note.size() <= 2000))
          && isTimestampNumber(data.createdAt)
          && isTimestampNumber(data.lastEditedAt);
      }

      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId)).data.members
        && isPersonalExpenseValid(request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && isPersonalExpenseValid(request.resource.data)
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /apps/waypoint/pendingRequests/{requestId} {
      function requestUid() {
        return requestId.split('_')[0];
      }

      function isMemberOfTrip(tripId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/apps/waypoint/trips/$(tripId))
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      allow read: if request.auth != null && (
        request.auth.uid == requestUid()
        || (resource != null && resource.data.uid == request.auth.uid)
        || (resource != null && isMemberOfTrip(resource.data.tripId))
      );
      allow create: if request.auth != null
        && requestId == request.resource.data.uid + '_' + request.resource.data.tripId
        && request.resource.data.keys().hasOnly(['uid', 'tripId', 'requestedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.tripId is string
        && isTimestampNumber(request.resource.data.requestedAt)
        && exists(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId))
        && !isMemberOfTrip(request.resource.data.tripId);
      allow delete: if request.auth != null
        && (
          request.auth.uid == requestUid()
          || (resource != null && isMemberOfTrip(resource.data.tripId))
        );
      allow update: if false;
    }

    // An Admin's standing approval for an email address. The person it is for reads and uses it
    // (with a verified email, so a made-up account can't claim it); the trip's members read it;
    // only the trip's Admins create, re-role or withdraw it. Adding the same address again overwrites
    // it with a plain set, so nothing needs to read the document first.
    match /apps/waypoint/emailInvites/{inviteId} {
      function tripOf(tripId) {
        return get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data;
      }

      function isAdminOfTrip(tripId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/apps/waypoint/trips/$(tripId))
          && request.auth.uid in tripOf(tripId).members
          && tripOf(tripId).members[request.auth.uid].role == 'ADMIN';
      }

      function isMemberOfTrip(tripId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/apps/waypoint/trips/$(tripId))
          && request.auth.uid in tripOf(tripId).members;
      }

      function isInvitee(email) {
        return request.auth != null
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '').lower() == email;
      }

      function isInviteShapeValid(data) {
        return data.keys().hasOnly(['tripId', 'email', 'role', 'invitedBy', 'invitedAt'])
          && data.tripId is string
          && data.email is string
          && data.email == data.email.lower()
          && data.email.matches('^[^@ /]+@[^@ /]+[.][^@ /]+$')
          && data.role in ['EDITOR', 'COMMENTER', 'VIEWER']
          && data.invitedBy is string
          && isTimestampNumber(data.invitedAt);
      }

      allow read: if resource != null && isInvitee(resource.data.email);
      allow read: if resource != null && isMemberOfTrip(resource.data.tripId);
      allow create: if request.auth != null
        && isInviteShapeValid(request.resource.data)
        && inviteId == request.resource.data.tripId + '_' + request.resource.data.email
        && request.resource.data.invitedBy == request.auth.uid
        && isAdminOfTrip(request.resource.data.tripId);
      allow update: if isAdminOfTrip(resource.data.tripId)
        && isInviteShapeValid(request.resource.data)
        && request.resource.data.tripId == resource.data.tripId
        && request.resource.data.email == resource.data.email
        && request.resource.data.invitedBy == request.auth.uid;
      allow delete: if isInvitee(resource.data.email) || isAdminOfTrip(resource.data.tripId);
    }

    // Fallback for any app doc that doesn't have an explicit /apps/{appId}
    // block above — same rule as every explicit app block, so a new app
    // works correctly even before it's given its own block.
    match /apps/{appId} {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Central, cross-app: lives at the top level rather than under any
    // single app's namespace, so every mini-app can schedule and read its
    // own reminders. Only the scheduled Cloud Function (Admin SDK, bypasses
    // rules) may mark one `sent` or roll a recurring one to its next date.
    match /reminders/{reminderId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.targetUids;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.targetUids;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.targetUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }
  }
}
