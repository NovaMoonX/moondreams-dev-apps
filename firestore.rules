    match /apps/nine-lives/households/{householdId}/litterEntries/{entryId} {
      function isLitterEntryIdentityValid() {
        return request.resource.data.id == entryId
          && request.resource.data.householdId == householdId;
      }

      function isLitterEntryBaseShapeValid() {
        return isNonEmptyString(request.resource.data.litterBoxId)
          && isNonEmptyString(request.resource.data.litterId)
          && request.resource.data.weightBefore is number
          && request.resource.data.weightBefore > 0
          && request.resource.data.weightUnit in ['lb', 'kg']
          && (request.resource.data.refillWeight == null || (request.resource.data.refillWeight is number && request.resource.data.refillWeight > 0))
          && request.resource.data.isFullChange is bool
          && (request.resource.data.isFullChange == false || request.resource.data.refillWeight != null)
          && isTimestampNumber(request.resource.data.loggedAt)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/litterBoxes/$(request.resource.data.litterBoxId))
          && exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/litters/$(request.resource.data.litterId));
      }

      function isLitterEntryImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterEntryIdentityValid()
        && isLitterEntryBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterEntryImmutableFieldsValid()
        && isLitterEntryBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
    }

    // --- App: worth-the-wait ---

    match /apps/worth-the-wait {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/worth-the-wait/inviteCodes/{inviteCode} {
      function isInviteCodeShapeValid() {
        return request.resource.data.keys().hasOnly(['spaceId'])
          && request.resource.data.spaceId is string
          && request.resource.data.spaceId.size() > 0;
      }

      function getInviteSpaceAfter() {
        return getAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId));
      }

      function isInviteCodeCreateValid() {
        return request.auth != null
          && inviteCode.size() == 6
          && isInviteCodeShapeValid()
          && !exists(/databases/$(database)/documents/apps/worth-the-wait/inviteCodes/$(inviteCode))
          && existsAfter(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId))
          && getInviteSpaceAfter().data.createdBy == request.auth.uid
          && request.auth.uid in getInviteSpaceAfter().data.members
          && getInviteSpaceAfter().data.inviteCode == inviteCode;
      }

      function isInviteCodeDeleteValid() {
        return request.auth != null
          && resource.data.spaceId is string
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId))
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(resource.data.spaceId)).data.createdBy == request.auth.uid;
      }

      // get() only — a space is joined by knowing its exact code, not by
      // enumerating every code, so listing this collection is denied.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if isInviteCodeCreateValid();
      allow delete: if isInviteCodeDeleteValid();
    }

    match /apps/worth-the-wait/pendingRequests/{uid} {
      function isPendingRequestIdentityValid() {
        return request.resource.data.uid == uid
          && request.resource.data.spaceId is string
          && request.resource.data.spaceId.size() > 0
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() > 0
          && request.resource.data.requestedAt is number;
      }

      function isSpaceMemberForRequest(spaceId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId))
          && request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
      }

      function isPendingRequestCreateValid() {
        return request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId))
          && !isSpaceMemberForRequest(request.resource.data.spaceId)
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId)).data.members.size() < 2
          // The submitted code must be the space's real invite code —
          // knowing a spaceId alone must never be enough to request in.
          && get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(request.resource.data.spaceId)).data.inviteCode == request.resource.data.inviteCode
          && isPendingRequestIdentityValid();
      }

      // Path-based own-uid check authorizes get() on a request that doesn't
      // exist yet; resource.data.spaceId lets the space-scoped list query
      // (used to review requests for a space) prove list-safety.
      allow read: if request.auth != null && (
        request.auth.uid == uid
          || (resource != null && isSpaceMemberForRequest(resource.data.spaceId))
      );
      allow create: if isPendingRequestCreateValid();
      allow delete: if request.auth != null && (
        request.auth.uid == uid || (resource != null && isSpaceMemberForRequest(resource.data.spaceId))
      );
      allow update: if false;
    }

    match /apps/worth-the-wait/spaces/{spaceId} {
      function isCreator(data) {
        return request.auth != null && request.auth.uid == data.createdBy;
      }

      function isMember(data) {
        return request.auth != null && request.auth.uid in data.members;
      }

      function isEncryptionConfigValid() {
        return request.resource.data.encryption is map
          && request.resource.data.encryption.appId == 'worth-the-wait'
          && request.resource.data.encryption.keyId is string
          && request.resource.data.encryption.keyId.size() > 0
          && request.resource.data.encryption.keyVersion is number
          && request.resource.data.encryption.key is string
          && request.resource.data.encryption.key.size() > 0;
      }

      function isCreateValid() {
        return request.auth != null
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.members is list
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.inviteCode is string
          && request.resource.data.inviteCode.size() == 6
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.activeAction == null
          && isEncryptionConfigValid();
      }

      // Which uid is being approved isn't re-checked here; mirrors Nine
      // Lives' isHouseholdUpdateValid, which doesn't cross-check either.
      // A member being added must correspond to a real pending request that
      // existed before this write and is deleted in the same commit — the
      // client batch is not itself a security boundary.
      function isApprovedMemberAddition() {
        let addedUids = request.resource.data.members.removeAll(resource.data.members);
        return addedUids.size() == 1
          && exists(/databases/$(database)/documents/apps/worth-the-wait/pendingRequests/$(addedUids[0]))
          && !existsAfter(/databases/$(database)/documents/apps/worth-the-wait/pendingRequests/$(addedUids[0]));
      }

      function isApprovalValid() {
        return request.auth != null
          && request.auth.uid == resource.data.createdBy
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'inviteCode', 'activeAction', 'welcomeSeenBy', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.inviteCode == null
          && request.resource.data.activeAction == null
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && isApprovedMemberAddition()
          && request.resource.data.updatedAt is number;
      }

      function isWelcomeSeenUpdateValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['welcomeSeenBy', 'updatedAt'])
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && request.resource.data.encryption == resource.data.encryption
          && request.resource.data.updatedAt is number
          && request.resource.data.welcomeSeenBy is map
          && request.resource.data.welcomeSeenBy[request.auth.uid] is number;
      }

      function isActiveActionStartValid() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.members == resource.data.members
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction != null
          && request.resource.data.activeAction.initiatedBy == request.auth.uid
          && request.resource.data.activeAction.status == 'initiating';
      }

      // Member-only: this doc carries the encryption key, so a pending
      // requester must never read it (join state lives in pendingRequests).
      allow read: if isMember(resource.data);

      allow create: if isCreateValid();

      allow update: if (
        (isCreator(resource.data) && isApprovalValid()) ||
        isWelcomeSeenUpdateValid() ||
        isActiveActionStartValid() ||
        (
          isMember(resource.data)
          && request.resource.data.members == resource.data.members
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.activeAction == resource.data.activeAction
          && isEncryptionConfigValid()
        )
      );

      allow delete: if isCreator(resource.data);

      match /memberUpdates/{userId} {
        function isCurrentSpaceMember() {
          return request.auth != null
            && request.auth.uid == userId
            && request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isMemberUpdateShapeValid() {
          return request.resource.data.userId == userId
            && request.resource.data.createdBoxes is number
            && request.resource.data.updatedBoxes is number
            && request.resource.data.newItems is number
            && request.resource.data.lastSurfacedAt is number
            && request.resource.data.updatedAt is number;
        }

        allow read: if isCurrentSpaceMember();
        allow create, update: if isCurrentSpaceMember() && isMemberUpdateShapeValid();
        allow delete: if false;
      }

      match /boxes/{boxId} {
        function isSpaceMember() {
          return request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/apps/worth-the-wait/spaces/$(spaceId)).data.members;
        }

        function isCreator() {
          return request.auth != null &&
            resource.data.createdBy == request.auth.uid
        }

        function isDefaultBox() {
          return resource.data.isDefault
        }

        function isRevealRequestChange() {
          return request.auth != null
            && isSpaceMember()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revealRequestedBy', 'revealHistory'])
            && request.resource.data.revealRequestedBy is list
            && request.resource.data.revealHistory is list;
        }

        allow read, create: if isSpaceMember();
        allow update: if isSpaceMember() && (
          (isCreator() && !isDefaultBox()) ||
          isRevealRequestChange()
        );
        allow delete: if isSpaceMember() && isCreator() && !isDefaultBox();

        match /items/{itemId} {
          function isAuthor() {
            return request.auth != null && resource.data.authorId == request.auth.uid;
          }

          allow read: if isSpaceMember();

          allow create: if isSpaceMember()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0
            && request.resource.data.createdAt is number
            && request.resource.data.lastEditedAt is number;

          allow update: if isAuthor()
            && request.resource.data.authorId == request.auth.uid
            && request.resource.data.content is map
            && 'value' in request.resource.data.content
            && request.resource.data.content.value.size() > 0;

          allow delete: if isAuthor();
        }
      }
    }

        // --- App: waypoint ---

    match /apps/waypoint {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /apps/waypoint/inviteCodes/{inviteCode} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['tripId', 'title'])
        && request.resource.data.tripId is string
        && isNonEmptyString(request.resource.data.title)
        && existsAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId))
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId)).data.title == request.resource.data.title
        && getAfter(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId)).data.inviteCode == inviteCode;
      allow update, delete: if false;
    }

    match /apps/waypoint/trips/{tripId} {
      function isTripMember() {
        return request.auth != null
          && request.auth.uid in resource.data.members;
      }

      function isTripAdmin() {
        return isTripMember()
          && resource.data.members[request.auth.uid].role == 'ADMIN';
      }

      function isTripFieldSetValid(data) {
        return data.keys().hasOnly([
            'id',
            'title',
            'coverImageUrl',
            'startDate',
            'endDate',
            'defaultCurrency',
            'isArchived',
            'members',
            'inviteCode',
            'createdBy',
            'createdAt',
            'lastEditedAt'
          ])
          && data.id == tripId
          && isNonEmptyString(data.title)
          && (data.coverImageUrl == null || data.coverImageUrl is string)
          && isTimestampNumber(data.startDate)
          && isTimestampNumber(data.endDate)
          && data.endDate >= data.startDate
          && (data.defaultCurrency == null || data.defaultCurrency is string)
          && (!('isArchived' in data) || data.isArchived is bool)
          && data.members is map
          && (data.inviteCode == null || data.inviteCode is string)
          && data.createdBy is string
          && isTimestampNumber(data.createdAt)
          && isTimestampNumber(data.lastEditedAt);
      }

      function isTripMemberEntryValid(member, uid) {
        return member is map
          && member.keys().hasOnly(['uid', 'role', 'joinedAt'])
          && member.uid == uid
          && member.role in ['ADMIN', 'EDITOR', 'COMMENTER', 'VIEWER']
          && isTimestampNumber(member.joinedAt);
      }

      function isTripCreateValid() {
        return request.auth != null
          && isTripFieldSetValid(request.resource.data)
          && request.resource.data.isArchived == false
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.members.keys().hasOnly([request.auth.uid])
          && isTripMemberEntryValid(
            request.resource.data.members[request.auth.uid],
            request.auth.uid
          )
          && request.resource.data.members[request.auth.uid].role == 'ADMIN';
      }

      function isTripUpdateValid() {
        return isTripFieldSetValid(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members;
      }

      function isTripEditorOrAdmin() {
        return request.auth != null
          && request.auth.uid in resource.data.members
          && resource.data.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      function isTripArchiveUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isArchived',
            'lastEditedAt'
          ])
          && request.resource.data.isArchived is bool
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isTripGeneralUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'coverImageUrl',
            'startDate',
            'endDate',
            'defaultCurrency',
            'lastEditedAt'
          ])
          && isTripUpdateValid();
      }

      function isTripMembershipApprovalValid() {
        let addedUids = request.resource.data.members.keys().removeAll(resource.data.members.keys());
        return isTripAdmin()
          && isTripFieldSetValid(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members.keys().hasAll(resource.data.members.keys())
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && addedUids.size() == 1
          && isTripMemberEntryValid(
            request.resource.data.members[addedUids[0]],
            addedUids[0]
          )
          && exists(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId))
          && get(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId)).data.uid == addedUids[0]
          && get(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId)).data.tripId == tripId
          && !existsAfter(/databases/$(database)/documents/apps/waypoint/pendingRequests/$(addedUids[0] + '_' + tripId));
      }

      function isTripMembershipManagementValid() {
        return isTripAdmin()
          && isTripFieldSetValid(request.resource.data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members.keys().hasAll([request.auth.uid, resource.data.createdBy])
          && request.resource.data.members[request.auth.uid]
            == resource.data.members[request.auth.uid]
          && request.resource.data.members[resource.data.createdBy]
            == resource.data.members[resource.data.createdBy]
          && (
            request.resource.data.members.keys().hasAll(resource.data.members.keys())
              && resource.data.members.keys().hasAll(request.resource.data.members.keys())
            || request.resource.data.members.size()
              == resource.data.members.size() - 1
          );
      }

      allow read: if isTripMember();
      allow create: if isTripCreateValid();
      allow update: if isTripMember() && (
        (isTripEditorOrAdmin() && isTripGeneralUpdate())
        || (isTripAdmin() && isTripArchiveUpdate())
        || isTripMembershipApprovalValid()
        || isTripMembershipManagementValid()
      );
      allow delete: if false;

      match /checklist/{checklistId} {
        function tripExists() {
          return exists(/databases/$(database)/documents/apps/waypoint/trips/$(tripId));
        }

        function isChecklistMember() {
          return request.auth != null
            && tripExists()
            && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
        }

        function hasChecklistRole(role) {
          return isChecklistMember()
            && get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members[request.auth.uid].role == role;
        }

        function isChecklistEditor() {
          return hasChecklistRole('ADMIN') || hasChecklistRole('EDITOR');
        }

        function isChecklistShapeValid(data) {
          return data.keys().hasOnly([
              'id',
              'tripId',
              'title',
              'category',
              'customCategoryLabel',
              'assignedToUids',
              'isCompleted',
              'markedCompletedByUid',
              'markedCompletedAt',
              'createdBy',
              'createdAt',
              'lastEditedAt'
            ])
            && data.id == checklistId
            && data.tripId == tripId
            && isNonEmptyString(data.title)
            && data.category in ['DOCUMENTS', 'PACKING', 'BOOKINGS', 'LOGISTICS', 'OTHER']
            && (data.customCategoryLabel == null || isNonEmptyString(data.customCategoryLabel))
            && (data.category != 'OTHER' || isNonEmptyString(data.customCategoryLabel))
            && data.assignedToUids is list
            && data.isCompleted is bool
            && (data.markedCompletedByUid == null || data.markedCompletedByUid is string)
            && (data.markedCompletedAt == null || isTimestampNumber(data.markedCompletedAt))
            && data.createdBy is string
            && isTimestampNumber(data.createdAt)
            && isTimestampNumber(data.lastEditedAt);
        }

        function isChecklistImmutableFieldsValid() {
          return request.resource.data.id == resource.data.id
            && request.resource.data.tripId == resource.data.tripId
            && request.resource.data.tripId == tripId
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.createdAt == resource.data.createdAt;
        }

        function isChecklistAssignedToggleValid() {
          return isChecklistMember()
            && request.auth.uid in resource.data.assignedToUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isCompleted',
              'markedCompletedByUid',
              'markedCompletedAt',
              'lastEditedAt'
            ])
            && request.resource.data.isCompleted is bool
            && (
              request.resource.data.isCompleted == false
                ? request.resource.data.markedCompletedByUid == null
                  && request.resource.data.markedCompletedAt == null
                : request.resource.data.markedCompletedByUid == request.auth.uid
                  && isTimestampNumber(request.resource.data.markedCompletedAt)
            )
            && isTimestampNumber(request.resource.data.lastEditedAt);
        }

        allow read: if isChecklistMember();
        allow create: if isChecklistEditor()
          && isChecklistShapeValid(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if (
          isChecklistEditor()
          && isChecklistShapeValid(request.resource.data)
          && isChecklistImmutableFieldsValid()
        ) || isChecklistAssignedToggleValid();
        allow delete: if isChecklistEditor();
      }
    }

    match /apps/waypoint/trips/{tripId}/events/{eventId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripSubcollectionEditor() {
        return isTripSubcollectionMember()
          && get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      function isEventShapeValid() {
        return request.resource.data.keys().hasOnly([
            'id',
            'tripId',
            'eventType',
            'dayIndex',
            'endDayIndex',
            'title',
            'startAt',
            'endAt',
            'locationName',
            'address',
            'latitude',
            'longitude',
            'eventDetails',
            'notes',
            'assignedMemberIds',
            'createdBy',
            'createdAt',
            'lastEditedAt'
          ])
          && request.resource.data.id == eventId
          && request.resource.data.tripId == tripId
          && request.resource.data.eventType in ['TRAVEL', 'DINING', 'ACTIVITY', 'FREE_TIME']
          && request.resource.data.dayIndex is int
          && request.resource.data.endDayIndex is int
          && request.resource.data.endDayIndex >= request.resource.data.dayIndex
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && isTimestampNumber(request.resource.data.startAt)
          && (request.resource.data.endAt == null || isTimestampNumber(request.resource.data.endAt))
          && (request.resource.data.locationName == null || request.resource.data.locationName is string)
          && (request.resource.data.address == null || request.resource.data.address is string)
          && (request.resource.data.latitude == null || request.resource.data.latitude is number)
          && (request.resource.data.longitude == null || request.resource.data.longitude is number)
          && (request.resource.data.eventDetails == null || request.resource.data.eventDetails is map)
          && (request.resource.data.notes == null || request.resource.data.notes is string)
          && request.resource.data.assignedMemberIds is list
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt);
      }

      function isEventImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.tripId == resource.data.tripId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      allow read: if isTripSubcollectionMember();
      allow create: if isTripSubcollectionEditor()
        && isEventShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isTripSubcollectionEditor()
        && isEventShapeValid()
        && isEventImmutableFieldsValid();
      // Issue 13 will narrow this to Admin-only once a trip has started.
      allow delete: if isTripSubcollectionEditor();
    }

    match /apps/waypoint/trips/{tripId}/stays/{stayId} {
      function isTripSubcollectionMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      function isTripSubcollectionEditor() {
        return isTripSubcollectionMember()
          && get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      allow read: if isTripSubcollectionMember();
      allow update: if isTripSubcollectionEditor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'checkInAt',
            'checkOutAt',
            'plannedArrivalAt',
            'plannedDepartureAt'
          ])
        && isTimestampNumber(request.resource.data.checkInAt)
        && isTimestampNumber(request.resource.data.checkOutAt)
        && isTimestampNumber(request.resource.data.plannedArrivalAt)
        && isTimestampNumber(request.resource.data.plannedDepartureAt);
    }

    match /apps/waypoint/pendingRequests/{requestId} {
      function requestUid() {
        return requestId.split('_')[0];
      }

      function isMemberOfTrip(tripId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/apps/waypoint/trips/$(tripId))
          && request.auth.uid in get(/databases/$(database)/documents/apps/waypoint/trips/$(tripId)).data.members;
      }

      allow read: if request.auth != null && (
        request.auth.uid == requestUid()
        || (resource != null && resource.data.uid == request.auth.uid)
        || (resource != null && isMemberOfTrip(resource.data.tripId))
      );
      allow create: if request.auth != null
        && requestId == request.resource.data.uid + '_' + request.resource.data.tripId
        && request.resource.data.keys().hasOnly(['uid', 'tripId', 'requestedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.uid is string
        && request.resource.data.tripId is string
        && isTimestampNumber(request.resource.data.requestedAt)
        && exists(/databases/$(database)/documents/apps/waypoint/trips/$(request.resource.data.tripId))
        && !isMemberOfTrip(request.resource.data.tripId);
      allow delete: if request.auth != null
        && (
          request.auth.uid == requestUid()
          || (resource != null && isMemberOfTrip(resource.data.tripId))
        );
      allow update: if false;
    }

    // Fallback for any app doc that doesn't have an explicit /apps/{appId}
    // block above — same rule as every explicit app block, so a new app
    // works correctly even before it's given its own block.
    match /apps/{appId} {
      allow read: if isAdmin() || isDevUser();
      allow read: if isUnrestrictedPublicApp(resource.data);
      allow read: if isUidAllowedApp(resource.data);
      allow read: if isEmailAllowedApp(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Central, cross-app: lives at the top level rather than under any
    // single app's namespace, so every mini-app can schedule and read its
    // own reminders. Only the scheduled Cloud Function (Admin SDK, bypasses
    // rules) may mark one `sent` or roll a recurring one to its next date.
    match /reminders/{reminderId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.targetUids;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.targetUids;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.targetUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'cancelled';
      allow delete: if false;
    }
  }
}
