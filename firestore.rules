      allow read: if isHouseholdMember(householdId);
      allow create: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterIdentityValid()
        && isLitterBaseShapeValid()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && isHouseholdMember(householdId)
        && isLitterImmutableFieldsValid()
        && isLitterBaseShapeValid();
      allow delete: if request.auth != null && isHouseholdMember(householdId);
