    match /apps/nine-lives/households/{householdId}/litters/{litterId} {
      function isLitterIdentityValid() {
        return request.resource.data.id == litterId
          && request.resource.data.householdId == householdId;
      }

      function isLitterBaseShapeValid() {
        return isNonEmptyString(request.resource.data.brand)
          && request.resource.data.litterType in [
            'clumping_clay', 'non_clumping_clay', 'pine_wood_pellet', 'paper',
            'crystal_silica', 'corn', 'wheat', 'walnut', 'custom'
          ]
          && (request.resource.data.customLitterTypeId == null || request.resource.data.customLitterTypeId is string)
          && request.resource.data.weight is number
          && request.resource.data.weight > 0
          && request.resource.data.weightUnit in ['lb', 'kg']
          && (request.resource.data.cost == null || (request.resource.data.cost is number && request.resource.data.cost >= 0))
          && request.resource.data.createdBy is string
          && isTimestampNumber(request.resource.data.createdAt)
          && isTimestampNumber(request.resource.data.lastEditedAt)
          && (request.resource.data.litterType != 'custom' || isNonEmptyString(request.resource.data.customLitterTypeId))
          && (
            request.resource.data.customLitterTypeId == null
              || exists(/databases/$(database)/documents/apps/nine-lives/households/$(householdId)/customLitterTypes/$(request.resource.data.customLitterTypeId))
          );
      }

      function isLitterImmutableFieldsValid() {
        return request.resource.data.id == resource.data.id
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.householdId == householdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
