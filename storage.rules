rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /nine-lives/households/{householdId}/cats/{catId}/{fileName} {
      function isHouseholdMember() {
        return request.auth != null
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/apps/nine-lives/households/$(householdId)
          ).data.members;
      }

      allow read: if isHouseholdMember();
      allow create, update: if isHouseholdMember()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isHouseholdMember();
    }

    match /nine-lives/households/{householdId}/health-records/{recordId} {
      function isHouseholdMember() {
        return request.auth != null
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/apps/nine-lives/households/$(householdId)
          ).data.members;
      }

      allow read: if isHouseholdMember();
      allow create, update: if isHouseholdMember()
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('image/.*')
        );
      allow delete: if isHouseholdMember();
    }

    match /users/{userId}/avatar {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // A store's own image, private to the person whose kitchen it is (mirrors apps/pinch/kitchens/{uid}/stores/{storeId}).
    match /apps/pinch/kitchens/{uid}/stores/{storeId}/{fileName} {
      function isKitchenOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isKitchenOwner();
      allow create, update: if isKitchenOwner()
        && fileName == 'logo.webp'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isKitchenOwner();
    }

    // A recipe's cover, private to the person whose kitchen it is.
    match /apps/pinch/kitchens/{uid}/recipes/{recipeId}/{fileName} {
      function isKitchenOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isKitchenOwner();
      allow create, update: if isKitchenOwner()
        && fileName == 'cover.webp'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isKitchenOwner();
    }

    // A shared recipe's cover, public by an unguessable path (the link is the capability), never listable and written only by the Functions.
    match /apps/pinch/shares/{shareId}/{fileName} {
      allow get: if shareId.matches('^[2-9a-hj-np-z]{26}$') && fileName.matches('^cover-[0-9]{1,2}\\.webp$');
      allow list, write: if false;
    }

    // A recipe idea's photo, private to the person whose kitchen it is (mirrors apps/pinch/kitchens/{uid}/ideas/{ideaId}).
    match /apps/pinch/kitchens/{uid}/ideas/{ideaId}/{fileName} {
      function isKitchenOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      allow read: if isKitchenOwner();
      allow create, update: if isKitchenOwner()
        && fileName == 'photo.webp'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isKitchenOwner();
    }

    match /waypoint/trips/{tripId}/cover/{fileName} {
      function isTripMember() {
        return request.auth != null
          && firestore.get(
            /databases/(default)/documents/apps/waypoint/trips/$(tripId)
          ).data.members[request.auth.uid] != null;
      }

      function isTripEditor() {
        return isTripMember()
          && firestore.get(
            /databases/(default)/documents/apps/waypoint/trips/$(tripId)
          ).data.members[request.auth.uid].role in ['ADMIN', 'EDITOR'];
      }

      allow read: if isTripMember();
      allow create, update: if isTripEditor()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isTripEditor();
    }
  }
}
